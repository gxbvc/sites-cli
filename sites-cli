#!/usr/bin/env ruby
# frozen_string_literal: true

# sites-cli — GXB tenant site management
#
# Three surfaces, one binary:
#
#   1. Runner commands (list/show/open/create) -- SITES_ROOT/bin/rails runner,
#      or kamal-cli runner with --prod. Staff credentials, not a site token.
#   2. Legacy file tools (describe_site/list_files/read_file/write_file/
#      edit_file/publish) -- HTTP to the site gateway, for sites still on the
#      file API (plans/24-agent-sites.md).
#   3. v2 tools (describe/read/save/create-branch/archive-branch/diff/publish/
#      merge-live/resolve-merge/history/revoke-preview, plus the upload/push/
#      wait-preview/check helpers) -- the same HTTP gateway, for versioned sites
#      (plans/30-agent-first-sites.md). Each subcommand posts the same-named
#      MCP tool; the shell is the transport, not a second contract.
#
# One credential covers all three: a personal token (sk_user_..., minted at
# /profile) is the platform door's bearer and the fallback for any slug with no
# site token, in which case each request names the site. See credential_for.
#
# Config: SITES_ROOT, SITES_CLI_HOST, SITES_CLI_CONFIG_DIR, SITES_CLI_TOKEN.

require 'json'
require 'tempfile'
require 'open3'
require 'fileutils'
require 'stringio'
require 'net/http'
require 'openssl'
require 'uri'
require 'securerandom'
require 'digest'

VERSION = '2.2.0'
SITES_ROOT = File.expand_path(ENV.fetch('SITES_ROOT', File.expand_path('~/projects/sites')))

# A worker thread that dies prints its own backtrace to stderr and takes the
# command's output with it. Every thread body below turns its own failure into
# a structured result instead, so a surprising server answer is JSON with the
# body attached and never a Ruby stack trace (pc_60d7aa4c, pc_e3810da4).
Thread.report_on_exception = false

# -----------------------------------------------------------------------------
# Output helpers
# -----------------------------------------------------------------------------

def emit(data)
  puts JSON.generate(data)
  $stdout.flush
end

def success(data)
  emit(ok: true, data: data)
  0
end

# status/body pass through the API's real HTTP status and full structured
# 409/422 payload (e.g. conflict path/version, branch/expected) instead of
# collapsing them into one message string.
def failure(msg, code: 'ERROR', status: nil, body: nil)
  payload = { ok: false, error: msg, code: code }
  payload[:status] = status if status
  payload[:body] = body if body
  emit(payload)
  1
end

# Internal failures travel as plain hashes so a worker thread (upload, push)
# can collect one per file instead of printing an envelope mid-flight. They
# reach stdout through fail_with, which prints exactly the shape above.
def api_error(msg, code: 'ERROR', status: nil, body: nil)
  { error: msg, code: code, status: status, body: body }
end

def fail_with(err)
  failure(err[:error], code: err[:code], status: err[:status], body: err[:body])
end

# -----------------------------------------------------------------------------
# Run the runner locally or through kamal-cli
# -----------------------------------------------------------------------------

def sites_env
  env = ENV.to_h
  version_file = File.join(SITES_ROOT, '.ruby-version')
  env['RBENV_VERSION'] = File.read(version_file).strip if File.file?(version_file)
  shims = File.expand_path('~/.rbenv/shims')
  env['PATH'] = "#{shims}:#{env['PATH']}" if File.directory?(shims)
  env
end

def run_runner(script, prod:)
  file = Tempfile.new(['sites-cli-', '.rb'])
  file.write(script)
  file.close

  if prod
    Dir.chdir(SITES_ROOT) do
      out, err, status = Open3.capture3(sites_env, 'kamal-cli', 'runner', file.path)
      return parse_kamal_output(out, err, status)
    end
  else
    Dir.chdir(SITES_ROOT) do
      out, err, status = Open3.capture3(sites_env, 'bin/rails', 'runner', file.path)
      if status.success?
        begin
          data = JSON.parse(out.lines.find { |l| l.start_with?('{') } || out)
          return success(data)
        rescue JSON::ParserError
          return success(stdout: out.strip, stderr: err.strip)
        end
      else
        return failure("rails runner failed\n#{err.strip}\n#{out.strip}", code: 'RUNNER_FAILED')
      end
    end
  end
ensure
  file&.unlink
end

def parse_kamal_output(out, err, status)
  begin
    parsed = JSON.parse(out)
  rescue JSON::ParserError
    return failure("kamal-cli did not return JSON\nOUT: #{out.strip}\nERR: #{err.strip}", code: 'KAMAL_JSON_ERROR')
  end

  unless parsed['ok']
    return failure("kamal-cli failed: #{parsed['error'] || parsed.inspect}", code: 'KAMAL_FAILED')
  end

  runner_stdout = parsed.dig('data', 'stdout').to_s
  runner_stderr = parsed.dig('data', 'stderr').to_s
  runner_status = parsed.dig('data', 'exit')

  if runner_status.to_i.zero?
    begin
      data = JSON.parse(runner_stdout.lines.find { |l| l.start_with?('{') } || runner_stdout)
      return success(data)
    rescue JSON::ParserError
      return success(stdout: runner_stdout.strip, stderr: runner_stderr.strip)
    end
  else
    return failure("runner exited #{runner_status}\n#{runner_stderr.strip}\n#{runner_stdout.strip}", code: 'RUNNER_EXIT_FAILED')
  end
end

# -----------------------------------------------------------------------------
# Stdout capture helper (used by open to extract URL without double-printing)
# -----------------------------------------------------------------------------

def capture_stdout
  old = $stdout
  $stdout = StringIO.new
  yield
  $stdout.string
ensure
  $stdout = old
end

# -----------------------------------------------------------------------------
# Runner-based commands: list / show / open / create
# -----------------------------------------------------------------------------

def cmd_list(prod:)
  script = <<~RUBY
    sites = Site.includes(:domains).order(:slug)
    puts JSON.generate(sites.map { |s| {
      slug: s.slug,
      name: s.name,
      status: s.status,
      host: s.canonical_host,
      url: "https://\#{s.canonical_host}",
      pages: s.pages.live.count
    }})
  RUBY
  run_runner(script, prod: prod)
end

def cmd_show(slug, prod:)
  script = <<~RUBY
    site = Site.find_by!(slug: #{JSON.dump(slug)})
    puts JSON.generate({
      slug: site.slug,
      name: site.name,
      status: site.status,
      host: site.canonical_host,
      url: "https://\#{site.canonical_host}",
      pages: site.pages.live.map { |p| { path: p.path, title: p.live_revision&.title } },
      domains: site.domains.pluck(:host),
      tailwind: site.settings["tailwind"],
      noindex: site.home&.noindex
    })
  RUBY
  run_runner(script, prod: prod)
end

def cmd_open(slug, prod:)
  script = <<~RUBY
    site = Site.find_by!(slug: #{JSON.dump(slug)})
    puts JSON.generate({ slug: site.slug, host: site.canonical_host, url: "https://\#{site.canonical_host}" })
  RUBY

  captured = capture_stdout { run_runner(script, prod: prod) }
  json_line = captured.lines.find { |l| l.start_with?('{') }
  output = json_line ? (JSON.parse(json_line) rescue {}) : {}
  return failure("could not resolve site URL", code: 'URL_ERROR') unless output['ok']

  url = output.dig('data', 'url')
  return failure("runner did not return a URL", code: 'URL_ERROR') unless url

  if prod
    system('open', url)
    return success(url: url, opened: true)
  else
    # Prose on stderr: stdout is one JSON envelope, always, so `sites-cli open
    # SLUG | jq` works the same as every other subcommand.
    $stderr.puts("open: production URL #{url}")
    $stderr.puts("open: local inspection -- curl -H 'Host: #{slug}.gxbsites.com' http://sites.localhost/")
    return success(url: url, opened: false, local_curl: "curl -H 'Host: #{slug}.gxbsites.com' http://sites.localhost/")
  end
end

# Staff-only create (plans/24-agent-sites.md slice 3 item 19, plan 30 section
# 1.1), with no credential at all beyond a shell on the box. `create-site`
# below is the HTTP form and is what an agent should use; this stays for a
# machine with the app checked out and no personal token minted yet. It makes
# a legacy site, not a versioned one.
def cmd_create(slug, name, team, prod:)
  script = <<~RUBY
    team = Team.find_or_create_by!(name: #{JSON.dump(team || 'GXB')})
    site = Site.create!(slug: #{JSON.dump(slug)}, name: #{JSON.dump(name || slug)}, team: team)
    puts JSON.generate({ slug: site.slug, name: site.name, host: site.canonical_host, url: "https://\#{site.canonical_host}" })
  RUBY
  run_runner(script, prod: prod)
end

# -----------------------------------------------------------------------------
# Config: tokens and remembered CAS tokens
# -----------------------------------------------------------------------------

CONFIG_DIR = File.expand_path(ENV.fetch('SITES_CLI_CONFIG_DIR', '~/.config/sites-cli'))
TOKENS_PATH = File.join(CONFIG_DIR, 'tokens.json')
STATE_PATH = File.join(CONFIG_DIR, 'state.json')
API_HOST = ENV.fetch('SITES_CLI_HOST', 'https://sites.gxb.vc')
DEFAULT_BRANCH = 'draft'
HTTP_TIMEOUT = 120

def load_json(path)
  File.file?(path) ? (JSON.parse(File.read(path)) rescue {}) : {}
end

def save_json(path, data)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(data))
  File.chmod(0o600, path)
end

# Credentials live outside this git checkout (~/.config, not ~/tools/sites-cli)
# and get tightened to owner-only on every read, in case the file was
# created or edited by hand with looser permissions.
def secure_permissions!(path)
  return unless File.file?(path)
  File.chmod(0o600, path) unless (File.stat(path).mode & 0o777) == 0o600
end

def token_for(slug)
  secure_permissions!(TOKENS_PATH)
  load_json(TOKENS_PATH)[slug]
end

# The two platform tools (list_sites, create_site) are not bound to a site, so
# they take a personal token (`sk_user_...`, minted from /profile on
# sites.gxb.vc) rather than a site token. SITES_CLI_TOKEN wins over the
# "_platform" entry in tokens.json.
def platform_token
  ENV['SITES_CLI_TOKEN'] || begin
    secure_permissions!(TOKENS_PATH)
    load_json(TOKENS_PATH)['_platform']
  end
end

# Which bearer opens a slug, and whether the request has to name the site.
#
# A site token carries its site inside the token, so those requests are sent
# exactly as they always were. A personal token carries a person: it opens
# every site that person can read, and the server resolves which one from a
# `site` field in the request (plan 30 section 4). So `site` is set only when
# the credential is the personal one, and one bearer covers create-site ->
# push -> save -> publish with no token step in the middle.
Credential = Struct.new(:token, :site)

def credential_for(slug)
  site_token = token_for(slug)
  return Credential.new(site_token, nil) if site_token

  personal = platform_token
  personal ? Credential.new(personal, slug) : nil
end

def no_credential_error(slug)
  api_error("no credential for #{slug}: add a site token for it to #{TOKENS_PATH}, or a personal token " \
            "(sk_user_..., minted at #{API_HOST}/profile) in SITES_CLI_TOKEN or as \"_platform\" there. " \
            'A personal token opens every site you can read; a site token opens exactly one.',
            code: 'NO_TOKEN')
end

# read_file caches {slug, path, version} locally so write/edit/publish can
# default --expected-version from the caller's own last read -- a write
# never preceded by a read still fails, and a 409 is never silently retried.
def state_key(slug, path) = "#{slug}/#{path}"

def remember_version(slug, path, version)
  return unless version
  state = load_json(STATE_PATH)
  state[state_key(slug, path)] = version
  save_json(STATE_PATH, state)
end

def cached_version(slug, path) = load_json(STATE_PATH)[state_key(slug, path)]

# The v2 half of the same idea: `expected` is a branch-head CAS token, so it
# is remembered per slug+branch rather than per path. Prefixed so it can
# never collide with a legacy "slug/path" key in the same flat file.
def expected_key(slug, branch) = "expected:#{slug}:#{branch}"

# A review is not a CAS token and is never defaulted into a request. It lives
# under its own key so `publish --review last` has to name it, which keeps
# spending a stale review a deliberate act rather than something the CLI does
# on an agent's behalf.
def review_key(slug, branch) = "last_review:#{slug}:#{branch}"

def cached_expected(slug, branch) = load_json(STATE_PATH)[expected_key(slug, branch)]

def cached_review(slug, branch) = load_json(STATE_PATH)[review_key(slug, branch)]

def forget_review(slug, branch)
  state = load_json(STATE_PATH)
  return unless state.delete(review_key(slug, branch))
  save_json(STATE_PATH, state)
end

# Called only with a 2xx body. A 409 branch_changed also carries the current
# `expected`, and deliberately does NOT come through here: learning the new
# token from the conflict is how a "never retried" conflict turns into a
# silent overwrite on the very next command.
#
# `data['name']` is the site's display name on describe_site, so only
# `data['branch']` names a branch at the top level; inside `branches[]` it is
# `name`. An explicit `"review": null` (a save whose build is not ready yet)
# drops the remembered review instead of leaving `--review last` pointed at a
# candidate that no longer describes this branch.
def remember_branch_state(slug, data)
  return unless data.is_a?(Hash)

  entries = [[data['branch'], data]]
  Array(data['branches']).each { |b| entries << [b['name'], b] if b.is_a?(Hash) }

  updates = {}
  entries.each do |name, entry|
    next if name.to_s.empty?
    updates[expected_key(slug, name)] = entry['expected'] unless entry['expected'].to_s.empty?
    updates[review_key(slug, name)] = entry['review'].to_s.empty? ? nil : entry['review'] if entry.key?('review')
  end
  return if updates.empty?

  state = load_json(STATE_PATH)
  updates.each { |key, value| value.nil? ? state.delete(key) : state[key] = value }
  save_json(STATE_PATH, state)
end

def resolve_expected(slug, branch, given)
  expected = given || cached_expected(slug, branch)
  return [expected, nil] if expected
  [nil, api_error("no --expected and nothing remembered for #{slug}/#{branch} -- run `sites-cli describe #{slug} --branch #{branch}` first",
                  code: 'NO_EXPECTED')]
end

# -----------------------------------------------------------------------------
# HTTP transport
# -----------------------------------------------------------------------------

NETWORK_ERRORS = [SocketError, SystemCallError, IOError, Timeout::Error, OpenSSL::SSL::SSLError].freeze

def http_request(req, uri)
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https',
                  open_timeout: 30, read_timeout: HTTP_TIMEOUT) { |http| http.request(req) }
end

def parse_api_response(res)
  body = begin
    JSON.parse(res.body.to_s)
  rescue JSON::ParserError
    { 'error' => res.body }
  end

  return [body, nil] if res.code.to_i.between?(200, 299)

  [nil, api_error(body['message'] || body['error'] || "HTTP #{res.code}",
                  code: (body['error'] || "HTTP_#{res.code}").to_s, status: res.code.to_i, body: body)]
end

TOOLS_PATH = '/api/v1/tools'
# The two tools with no site to be bound to have their own door, and a site
# token there is a 403, printed verbatim (plan 30 section 4).
PLATFORM_TOOLS_PATH = '/api/v1/platform/tools'

def api_call(slug, tool, arguments, credential: nil, path: TOOLS_PATH)
  credential ||= credential_for(slug)
  return [nil, no_credential_error(slug)] unless credential

  uri = URI.join(API_HOST, path)
  req = Net::HTTP::Post.new(uri)
  req['Authorization'] = "Bearer #{credential.token}"
  req['Content-Type'] = 'application/json'
  envelope = { tool: tool, arguments: arguments }
  envelope[:site] = credential.site if credential.site
  req.body = JSON.generate(envelope)

  parse_api_response(http_request(req, uri))
rescue *NETWORK_ERRORS => e
  [nil, api_error("#{tool} request failed: #{e.class}: #{e.message}", code: 'HTTP_ERROR')]
end

# Every v2 subcommand is the same three steps: post the same-named tool,
# remember whatever branch head token the response carries, print {ok, data}.
#
# `remember: false` is for `read --at`: a historical read answers with the
# snapshot token it read under the same `branch`/`expected` keys, so caching it
# would hand the next `save` a token for a snapshot nobody is on.
def tool_call(slug, tool, arguments, credential: nil, remember: true, path: TOOLS_PATH)
  data, err = api_call(slug, tool, arguments, credential: credential, path: path)
  return fail_with(err) if err
  remember_branch_state(slug, data) if remember
  success(data)
end

# -----------------------------------------------------------------------------
# Platform tools: list_sites and create_site, over POST /api/v1/platform/tools
# with a personal bearer. These two have no site to name, which is exactly why
# they have their own door: the site door answers `create_site` with a 403
# pointing back here.
# -----------------------------------------------------------------------------

def platform_token_error(what, extra = nil)
  message = "#{what} needs a personal token (sk_user_...): mint one at #{API_HOST}/profile, then set " \
            "SITES_CLI_TOKEN or add it to #{TOKENS_PATH} as \"_platform\""
  message += ". #{extra}" if extra
  api_error(message, code: 'NO_TOKEN')
end

def platform_tool_call(slug, tool, arguments, what, extra = nil)
  token = platform_token
  return fail_with(platform_token_error(what, extra)) unless token
  # No `site` field here: these two tools have no site to be bound to, and
  # create_site takes the slug as an argument instead.
  tool_call(slug, tool, arguments, credential: Credential.new(token, nil), path: PLATFORM_TOOLS_PATH)
end

# The two platform schemas, from the server rather than from this file. Not on
# the --help path on purpose: printing help should never make a request.
def cmd_platform_tools
  token = platform_token
  return fail_with(platform_token_error('platform-tools')) unless token

  uri = URI.join(API_HOST, PLATFORM_TOOLS_PATH)
  req = Net::HTTP::Get.new(uri)
  req['Authorization'] = "Bearer #{token}"
  data, err = parse_api_response(http_request(req, uri))
  return fail_with(err) if err
  success(data)
rescue *NETWORK_ERRORS => e
  failure("platform-tools request failed: #{e.class}: #{e.message}", code: 'HTTP_ERROR')
end

# -----------------------------------------------------------------------------
# The two site tools that had no subcommand: list_submissions and get_analytics.
# -----------------------------------------------------------------------------

# Agent::AnalyticsClient::ALLOWED_PERIODS. Checked locally so a typo costs no
# round trip, the same rule an unknown --flag gets.
ANALYTICS_PERIODS = %w[today yesterday 7d 30d all].freeze

# `read` stopped containing `read_submissions` in slice F, and a token's scopes
# are fixed when it is minted -- so the recovery is a new token, not a retry.
def cmd_list_submissions(slug, base, form:, since:, limit:)
  args = base.dup
  args['form_slug'] = form if form
  args['since'] = since if since
  args['limit'] = limit.to_i if limit

  data, err = api_call(slug, 'list_submissions', args)
  if err
    if err.dig(:body, 'capability') == 'read_submissions' || err[:error].to_s.include?('read_submissions')
      $stderr.puts("this token does not carry read_submissions, which is its own capability since slice F: " \
                   "reading a site's source is not reading the contact details people typed into its forms.")
      $stderr.puts("next: mint a token with the read_submissions box ticked -- a personal one at " \
                   "#{API_HOST}/profile, or the site's own on its admin page (a scope cannot be added to a " \
                   "token that already exists) -- then put it in SITES_CLI_TOKEN or #{TOKENS_PATH}.")
    end
    return fail_with(err)
  end
  success(data)
end

# -----------------------------------------------------------------------------
# Legacy file tools: describe_site, list_files, read_file, write_file,
# edit_file, publish (plans/24-agent-sites.md slice 3 item 18). A site token is
# scoped to exactly one site, unlike the runner credentials above.
# -----------------------------------------------------------------------------

def cmd_describe_site(slug, arguments)
  data, err = api_call(slug, 'describe_site', arguments)
  return fail_with(err) if err
  remember_branch_state(slug, data)
  success(data)
end

def cmd_list_files(slug, prefix)
  data, err = api_call(slug, 'list_files', prefix ? { prefix: prefix } : {})
  return fail_with(err) if err
  success(data)
end

def cmd_read_file(slug, path, view:)
  data, err = api_call(slug, 'read_file', { path: path, view: view })
  return fail_with(err) if err
  remember_version(slug, path, data['version'])
  success(data)
end

def cmd_write_file(slug, path, content, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'write_file', { path: path, content: content, expected_version: version })
  return fail_with(err) if err
  remember_version(slug, path, data['version'])
  success(data)
end

def cmd_edit_file(slug, path, edits, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'edit_file', { path: path, edits: edits, expected_version: version })
  return fail_with(err) if err
  remember_version(slug, path, data['version'])
  success(data)
end

# -----------------------------------------------------------------------------
# publish, the versioned form (plan 30 section 5.2). Two calls, not one:
# `--expected --keys` proposes a candidate and answers published:false, and the
# `--review` it hands back is the only thing that moves live.
# -----------------------------------------------------------------------------

def remember_review(slug, branch, review)
  return if review.to_s.empty?
  state = load_json(STATE_PATH)
  state[review_key(slug, branch)] = review
  save_json(STATE_PATH, state)
end

def cmd_publish_review(slug, review, branch, base, idempotency)
  if review == 'last'
    review = cached_review(slug, branch)
    unless review
      return failure("no review remembered for #{slug}/#{branch} -- run `sites-cli describe #{slug} --branch #{branch}` " \
                     "and pass branches[].review, or take the review a save or a `publish --keys` returned",
                     code: 'NO_REVIEW')
    end
  end

  data, err = api_call(slug, 'publish', base.merge('review' => review,
                                                   'idempotency_key' => idempotency || SecureRandom.uuid))
  return fail_with(err) if err
  # A spent review is not a review any more -- publishing with it again is a
  # 409 upstream_changed. Only the branch this token was actually remembered
  # for is cleared, so an explicit token for another branch changes nothing.
  forget_review(slug, branch) if data['published'] && cached_review(slug, branch) == review
  remember_branch_state(slug, data)
  success(data)
end

def cmd_publish_keys(slug, branch, args)
  data, err = api_call(slug, 'publish', args)
  return fail_with(err) if err
  remember_branch_state(slug, data)
  code = success(data)
  return code unless data['published'] == false

  # A proposal is a real 200 and the CLI did exactly what it was asked, so this
  # exits 0 -- but published:false is never "shipped", and the second call is
  # the one that flips live.
  remember_review(slug, branch, data['review'])
  included = Array(data['included']).size
  left = Array(data['left_on_branch']).size
  $stderr.puts("published: false -- live is unchanged. #{included} key(s) in the candidate, #{left} left on #{branch}.")
  $stderr.puts("next: preview it, then `sites-cli publish #{slug} --review last` (or --review \"<token>\") to flip live.")
  code
end

def cmd_publish_legacy(slug, path, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version -- read_file/describe_site #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'publish', { path: path, expected_version: version })
  return fail_with(err) if err
  success(data)
end

# -----------------------------------------------------------------------------
# Media upload: authorize -> stage bytes -> complete -> poll until
# ready/failed. A photo (plans/24 5a) is one presigned PUT streamed from disk.
# A video (5b) is multipart: bounded batches of part presigns, each part
# retried independently, a bounded number of parts in flight at once, and an
# abort call if it can't be finished -- never the whole file buffered at once
# either way. A versioned site (plan 30 section 1.1 step 2) omits `label` and
# sends `filename`; the digest in the response is what `save` binds.
# -----------------------------------------------------------------------------

# What the legacy file API takes. Unchanged on purpose: a legacy site's
# assets/ label is the name its published HTML already references.
MEDIA_CONTENT_TYPES = {
  '.jpg' => 'image/jpeg', '.jpeg' => 'image/jpeg', '.png' => 'image/png',
  '.webp' => 'image/webp', '.gif' => 'image/gif', '.mp4' => 'video/mp4'
}.freeze

# The plan 30 / slice B set. .mjs is accepted as a filename but the server
# delivers it as asset.js with text/javascript -- the suffix comes from the
# validated type, never from the filename (slice B deviation 3).
UPLOAD_CONTENT_TYPES = MEDIA_CONTENT_TYPES.merge(
  '.js' => 'text/javascript', '.mjs' => 'text/javascript',
  '.css' => 'text/css', '.svg' => 'image/svg+xml',
  '.glb' => 'model/gltf-binary',
  '.woff' => 'font/woff', '.woff2' => 'font/woff2',
  '.json' => 'application/json', '.txt' => 'text/plain'
).freeze

# A vendored bundle's licence has no extension, so the extension table cannot
# type it and the notice cannot sit next to the code it covers (slice G
# friction 15). These are the conventional extensionless text files, and
# text/plain is already an accepted asset kind.
TEXT_FILENAMES = %w[LICENSE LICENCE NOTICE COPYING COPYRIGHT AUTHORS PATENTS].freeze

# The server takes any content type now (uploads brief item 2), so the table
# above is a hint for the types the platform has opinions about, not a gate.
# Anything it does not name is typed by extension through Marcel (or
# mime-types, whichever is installed) and finally as octet-stream. The one
# refusal left is on the server: a type a browser would execute as a page on
# cdn.gxbsites.com, which is a 422 whose message is printed verbatim.
REFUSED_UPLOAD_TYPES = %w[text/html application/xhtml+xml].freeze
FALLBACK_CONTENT_TYPE = 'application/octet-stream'
# Single PUT up to here; the server asks for the multipart transport above it
# and the CLI follows `multipart` in the authorize response either way.
MULTIPART_THRESHOLD_BYTES = 25 * 1024 * 1024

# Loaded once, and only if it is there: neither gem ships with Ruby, and an
# upload must not depend on whether a Rails app happens to be installed next
# to this script.
def mime_lookup(name)
  @mime_lookup ||= begin
    require 'marcel'
    ->(filename) { Marcel::MimeType.for(name: filename).to_s }
  rescue LoadError
    begin
      require 'mime/types'
      ->(filename) { MIME::Types.type_for(filename).first&.content_type.to_s }
    rescue LoadError
      ->(_filename) { '' }
    end
  end
  found = @mime_lookup.call(name)
  found.empty? || found == FALLBACK_CONTENT_TYPE ? nil : found
end

def content_type_for(path)
  name = File.basename(path)
  extension = File.extname(name).downcase
  return UPLOAD_CONTENT_TYPES[extension] if UPLOAD_CONTENT_TYPES.key?(extension)
  return 'text/plain' if extension.empty? && TEXT_FILENAMES.include?(name.upcase)
  mime_lookup(name) || FALLBACK_CONTENT_TYPE
end

def accepted_types_note
  "any file. #{UPLOAD_CONTENT_TYPES.keys.join(' ')} and an extensionless " \
    "#{TEXT_FILENAMES.join('/')} are typed from this table; anything else is typed by extension and " \
    "falls back to #{FALLBACK_CONTENT_TYPE}. The platform refuses only what a browser would run as a " \
    "page on the asset CDN (#{REFUSED_UPLOAD_TYPES.join(', ')}, or anything that sniffs as HTML) -- " \
    'a page belongs in a page document. Single PUT to 25 MB, multipart above it'
end

PART_CONCURRENCY = 4
PART_MAX_ATTEMPTS = 3
UPLOAD_CONCURRENCY = 4
UPLOAD_POLL_TIMEOUT = 300
UPLOAD_POLL_INTERVAL = 1

# A personal token names the site in the JSON body, the same field the tools
# envelope carries. GET and DELETE have no body, so there it rides in the
# query string instead -- same param, same resolution on the server.
def media_api_call(slug, method, path, body, credential: nil)
  credential ||= credential_for(slug)
  return [nil, no_credential_error(slug)] unless credential

  path = "#{path}?site=#{credential.site}" if credential.site && body.nil?
  uri = URI.join(API_HOST, path)
  req_class = { get: Net::HTTP::Get, delete: Net::HTTP::Delete }.fetch(method, Net::HTTP::Post)
  req = req_class.new(uri)
  req['Authorization'] = "Bearer #{credential.token}"
  if body
    body = body.merge(site: credential.site) if credential.site
    req['Content-Type'] = 'application/json'
    req.body = JSON.generate(body)
  end

  parse_api_response(http_request(req, uri))
rescue *NETWORK_ERRORS => e
  [nil, api_error("upload request failed: #{e.class}: #{e.message}", code: 'HTTP_ERROR')]
end

# A streamed PUT (body_stream, not the whole file in memory) against the
# presigned URL the authorize step returned. content_length must match the
# byte_size sent at authorize -- R2 rejects the signature otherwise.
def put_upload(upload_url, file_path, content_type, byte_size)
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req['Content-Type'] = content_type
  req.content_length = byte_size
  req.body_stream = File.open(file_path, 'rb')
  res = http_request(req, uri)
  req.body_stream.close
  res.code.to_i.between?(200, 299) ? nil : api_error("upload PUT failed: HTTP #{res.code}", code: 'UPLOAD_FAILED', status: res.code.to_i)
rescue *NETWORK_ERRORS => e
  api_error("upload PUT failed: #{e.class}: #{e.message}", code: 'UPLOAD_FAILED')
end

# The whole authorize -> stage -> complete -> poll flow for one file. `target`
# carries either a legacy {label:, expected_version:} or a versioned
# {filename:, digest:}. Returns the final upload_status body.
def media_upload(slug, file_path, content_type, target, credential:)
  byte_size = File.size(file_path)
  data, err = media_api_call(slug, :post, '/api/v1/media/uploads',
                             target.merge(content_type: content_type, byte_size: byte_size), credential: credential)
  return [nil, err] if err
  upload_id = data['id']

  # The platform is content addressed, so when it already holds these bytes
  # authorize answers `ready` with the blob URL and no upload_url at all. That
  # is the fast path the digest hint exists for and the one plan 30 is built
  # around -- it used to hand nil to URI() and print a thread backtrace
  # (pc_60d7aa4c, pc_e3810da4, pc_c3606ecf). Nothing to PUT, complete or poll.
  return [data.merge('deduplicated' => true), nil] if data['status'] == 'ready'

  if data['multipart']
    parts, part_err = upload_video_parts(slug, upload_id, file_path, data['parts_count'], data['part_size'], credential: credential)
    if part_err
      media_api_call(slug, :delete, "/api/v1/media/uploads/#{upload_id}", nil, credential: credential)
      return [nil, part_err]
    end
    complete_body = { parts: parts }
  elsif data['upload_url'].to_s.empty?
    # Not "ready", not multipart, and nowhere to send bytes. Say what came back
    # rather than dying inside URI().
    return [nil, api_error("authorize for #{File.basename(file_path)} answered status " \
                           "#{data['status'].inspect} with no upload_url and no multipart plan, so there is " \
                           'nowhere to send the bytes', code: 'UPLOAD_UNEXPECTED', body: data)]
  else
    put_err = put_upload(data['upload_url'], file_path, content_type, byte_size)
    return [nil, put_err] if put_err
    complete_body = {}
  end

  data, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/complete", complete_body, credential: credential)
  return [nil, err] if err

  deadline = Time.now + UPLOAD_POLL_TIMEOUT
  until %w[ready failed].include?(data['status'])
    return [nil, api_error("upload #{upload_id} still #{data['status']} after #{UPLOAD_POLL_TIMEOUT}s", code: 'UPLOAD_TIMEOUT', body: data)] if Time.now >= deadline
    sleep UPLOAD_POLL_INTERVAL
    data, err = media_api_call(slug, :get, "/api/v1/media/uploads/#{upload_id}", nil, credential: credential)
    return [nil, err] if err
  end

  unless data['status'] == 'ready'
    return [nil, api_error(data['error'] || 'upload verification failed',
                           code: (data['error_code'] || 'UPLOAD_FAILED').to_s, body: data)]
  end

  [data, nil]
end

def cmd_write_file_upload(slug, path, file_path, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version
  return failure("no such file: #{file_path}", code: 'NO_FILE') unless File.file?(file_path)

  content_type = MEDIA_CONTENT_TYPES[File.extname(file_path).downcase]
  return failure("unsupported file extension #{File.extname(file_path)} -- accepts jpg/jpeg/png/webp/gif/mp4", code: 'BAD_TYPE') unless content_type

  data, err = media_upload(slug, file_path, content_type,
                           { label: path, expected_version: version }, credential: credential_for(slug))
  return fail_with(err) if err

  remember_version(slug, path, data['id'].to_s)
  success(data)
end

# Bounded-parallelism multipart upload (plans/24-agent-sites.md 5b): a fixed
# worker count pulls part numbers off a shared queue, each part fetched and
# retried independently (PART_MAX_ATTEMPTS each, a fresh presign every
# attempt so an expired one just renews), at most one part's bytes
# (part_size, 16 MiB) resident per worker regardless of total file size.
def upload_video_parts(slug, upload_id, file_path, parts_count, part_size, credential:)
  total_size = File.size(file_path)
  queue = Queue.new
  (1..parts_count).each { |n| queue << n }
  results = Array.new(parts_count)
  mutex = Mutex.new
  first_error = nil

  workers = [ PART_CONCURRENCY, parts_count ].min.times.map do
    Thread.new do
      loop do
        part_number = begin queue.pop(true) rescue nil end
        break unless part_number
        mutex.synchronize { break if first_error }

        etag, err = begin
          upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size, credential: credential)
        rescue StandardError => e
          [nil, api_error("part #{part_number} raised #{e.class}: #{e.message}", code: 'PART_UPLOAD_FAILED')]
        end
        mutex.synchronize do
          if err
            first_error ||= err
          else
            results[part_number - 1] = { part_number: part_number, etag: etag }
          end
        end
      end
    end
  end
  workers.each(&:join)

  return [ nil, first_error ] if first_error
  [ results, nil ]
end

def upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size, credential:)
  offset = (part_number - 1) * part_size
  length = [ part_size, total_size - offset ].min

  attempts = 0
  loop do
    attempts += 1
    presign, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/parts",
                                  { part_numbers: [ part_number ] }, credential: credential)
    return [ nil, err ] if err

    part_url = presign.dig('parts', 0, 'upload_url')
    return [ nil, api_error("no presigned URL returned for part #{part_number}", code: 'PART_UPLOAD_FAILED') ] unless part_url

    etag = put_part(part_url, file_path, offset, length)
    return [ etag, nil ] if etag
    return [ nil, api_error("part #{part_number} failed after #{attempts} attempts", code: 'PART_UPLOAD_FAILED') ] if attempts >= PART_MAX_ATTEMPTS
  end
end

# Bounded to exactly this part's bytes (<=16 MiB), never the whole file.
def put_part(upload_url, file_path, offset, length)
  bytes = File.open(file_path, 'rb') { |f| f.seek(offset); f.read(length) }
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req.content_length = length
  req.body = bytes
  res = http_request(req, uri)
  res.code.to_i.between?(200, 299) ? res['etag'] : nil
rescue *NETWORK_ERRORS
  nil
end

# -----------------------------------------------------------------------------
# v2 helpers: upload, push, wait-preview, check
# -----------------------------------------------------------------------------

def sha256_file(path) = Digest::SHA256.file(path).hexdigest

# One line of JSON per file, so a caller can map a local path to the digest it
# has to `save`. Four at a time; exit 1 if any file failed.
def cmd_upload(slug, files)
  return failure("upload requires SLUG FILE [FILE...]", code: 'USAGE') if files.empty?

  missing = files.reject { |f| File.file?(f) }
  return failure("no such file(s): #{missing.join(' ')}", code: 'NO_FILE') if missing.any?

  credential = credential_for(slug)
  return fail_with(no_credential_error(slug)) unless credential

  results = upload_files(slug, files, credential: credential)
  results.each { |r| emit(r) }
  results.all? { |r| r[:status] == 'ready' } ? 0 : 1
end

def upload_files(slug, files, credential:)
  results = Array.new(files.size)
  queue = Queue.new
  files.each_index { |i| queue << i }

  workers = [ UPLOAD_CONCURRENCY, files.size ].min.times.map do
    Thread.new do
      loop do
        index = begin queue.pop(true) rescue nil end
        break unless index
        results[index] = begin
          upload_one_file(slug, files[index], credential: credential)
        rescue StandardError => e
          # A raise here used to escape the thread and print a backtrace with
          # nothing on stdout. One file's surprise is one file's failed line.
          { path: files[index], status: 'failed', code: 'UPLOAD_UNEXPECTED',
            error: "#{e.class}: #{e.message}" }
        end
      end
    end
  end
  workers.each(&:join)
  results
end

def upload_one_file(slug, file_path, credential:)
  content_type = content_type_for(file_path)
  digest = sha256_file(file_path)
  # `label` is omitted on a versioned site: bytes are bound to a logical path
  # later by `save`, not now. `digest` is the type-conflict hint slice B added.
  data, err = media_upload(slug, file_path, content_type,
                           { filename: File.basename(file_path), digest: digest }, credential: credential)
  if err
    return { path: file_path, status: 'failed', code: err[:code], error: err[:error],
             http_status: err[:status], body: err[:body] }.compact
  end

  { path: file_path, digest: data['digest'] || digest, url: data['url'],
    media_type: data['media_type'] || data['content_type'], byte_size: data['byte_size'] || data['bytes'],
    status: data['status'], deduplicated: data['deduplicated'] }.compact
end

# Dir.glob rather than `find` (which walks huge trees and hangs): '**/*' skips
# dotfiles and never descends into a dot directory, which is the same set
# `rg --files` lists for a tree with no .gitignore.
def walk_tree(dir)
  Dir.glob('**/*', base: dir)
     .reject { |rel| rel.split('/').any? { |segment| segment.start_with?('.') } }
     .select { |rel| File.file?(File.join(dir, rel)) }
     .sort
end

def push_entries(dir, prefix)
  walk_tree(dir).map do |rel|
    absolute = File.join(dir, rel)
    # A tree that already contains assets/ is not prefixed twice.
    key = rel.start_with?(prefix) ? rel : "#{prefix}#{rel}"
    { 'file' => absolute, 'key' => key, 'digest' => sha256_file(absolute),
      'media_type' => content_type_for(rel), 'byte_size' => File.size(absolute) }
  end
end

# One `read {kind: "asset", keys: [...]}` round trip answers "which of these
# logical paths are already bound, and to what", so a re-push of a tree that
# barely moved uploads only what changed (slice E). The batch form is bounded
# to READ_KEYS_LIMIT keys per call. A server that predates it answers 404
# (unknown tool) or 422; both mean "ask for nothing", and the digest hint on
# the upload itself still short-circuits known bytes server-side (slice D), so
# the fallback costs a round trip per file rather than a wrong answer.
READ_KEYS_LIMIT = 1000

def bound_digests(slug, branch, keys, credential:)
  bound = {}
  head = nil
  keys.each_slice(READ_KEYS_LIMIT) do |slice|
    data, err = api_call(slug, 'read', { 'kind' => 'asset', 'keys' => slice, 'branch' => branch }, credential: credential)
    return [nil, nil, err] if err
    remember_branch_state(slug, data)
    bound.merge!(data['digests'] || {})
    head = data['expected'] if data['expected']
  end
  [bound, head, nil]
end

def push_change_for(entry) = { 'op' => 'put', 'kind' => 'asset', 'key' => entry['key'], 'digest' => entry['digest'] }

def push_file_report(entries)
  entries.map { |e| e.slice('key', 'file', 'digest', 'media_type', 'byte_size') }
end

# The one describe_site a rehearsal needs. A dry run that never asks the server
# anything cannot tell you the thing most worth knowing -- that this site is
# still on the legacy file API and the real call would be a 409 (slice G
# friction 10). `--offline` is the old behaviour when there is no token to ask
# with.
def push_preflight(slug, branch)
  credential = credential_for(slug)
  unless credential
    err = no_credential_error(slug)
    return [nil, err.merge(error: "#{err[:error]} Or rehearse locally with --offline.")]
  end

  # No `branch` argument: whether this site has branches at all is the question
  # being asked, and a legacy describe_site answers `branch:` with 422
  # invalid_request rather than with its own shape.
  data, err = api_call(slug, 'describe_site', {}, credential: credential)
  return [nil, err] if err
  remember_branch_state(slug, data)

  unless data['versioned'] == true || data.key?('branches')
    return [nil, api_error("#{slug} is still on the legacy file API, so this push would be a 409 upgrade_required. " \
                           "Upload one file at a time with `sites-cli write_file #{slug} assets/NAME --file PATH`.",
                           code: 'NOT_VERSIONED', body: data.slice('site', 'url', 'permissions'))]
  end

  entry = Array(data['branches']).find { |b| b.is_a?(Hash) && b['name'] == branch }
  unless entry
    names = Array(data['branches']).filter_map { |b| b['name'] if b.is_a?(Hash) }
    return [nil, api_error("#{slug} has no branch #{branch.inspect} (it has #{names.join(', ')}) -- " \
                           "`sites-cli create-branch #{slug} #{branch}` first", code: 'NO_BRANCH')]
  end
  [entry, nil]
end

def cmd_push(slug, dir, branch:, prefix:, expected:, dry_run:, offline: false)
  return failure("no such directory: #{dir}", code: 'NO_DIR') unless File.directory?(dir)

  entries = push_entries(dir, prefix)
  # A site whose pages reference nothing is an ordinary site, not a usage
  # error, and `push && save` should not have to special-case it (pc_6b2ffb91).
  # The contract check is the half of a dry run worth having, so an empty tree
  # still gets it.
  if entries.empty?
    $stderr.puts("push: no files under #{dir} (dotfiles and dot directories are skipped) -- nothing to upload")
    payload = { 'site' => slug, 'branch' => branch, 'prefix' => prefix, 'files' => 0,
                'unchanged' => 0, 'saved' => false, 'changes' => [],
                'contract' => offline ? 'unchecked' : 'versioned' }
    payload['dry_run'] = true if dry_run
    return success(payload) if offline
    entry, err = push_preflight(slug, branch)
    return fail_with(err) if err
    payload['expected'] = expected || entry['expected']
    payload['preview_status'] = entry['preview_status']
    return success(payload)
  end

  html = entries.select { |e| REFUSED_UPLOAD_TYPES.include?(e['media_type']) }
  if html.any?
    $stderr.puts("push: #{html.size} file(s) under #{dir} are #{html.first['media_type']}, which the platform " \
                 'refuses as a blob -- a page belongs in a page document (`save --page KEY --html FILE`). ' \
                 "The upload will answer 422 and print what it said: #{html.map { |e| e['key'] }.join(', ')}")
  end

  if dry_run
    payload = { 'site' => slug, 'branch' => branch, 'dry_run' => true, 'prefix' => prefix,
                'files' => entries.size, 'bytes' => entries.sum { |e| e['byte_size'] },
                'contract' => offline ? 'unchecked' : 'versioned',
                'changes' => entries.map { |e| push_change_for(e) }, 'file_details' => push_file_report(entries) }
    unless offline
      entry, err = push_preflight(slug, branch)
      return fail_with(err) if err
      payload['expected'] = expected || entry['expected']
      payload['preview_status'] = entry['preview_status']
    end
    return success(payload)
  end

  given_expected = expected
  expected, err = resolve_expected(slug, branch, expected)
  return fail_with(err) if err

  credential = credential_for(slug)
  return fail_with(no_credential_error(slug)) unless credential

  bound, head, read_err = bound_digests(slug, branch, entries.map { |e| e['key'] }, credential: credential)
  if read_err
    # Only "this server has no batch asset read" is survivable. A 401, a 403 or
    # the 409 a legacy site answers is the same wall the save would hit anyway.
    return fail_with(read_err) unless [404, 422].include?(read_err[:status])
    bound = {}
  end
  # The read just looked at the branch head, so it is the freshest CAS token
  # there is -- unless the caller named one, which always wins.
  expected = head if head && given_expected.nil?

  unchanged, changed = entries.partition { |e| bound[e['key']] == e['digest'] }
  changes = changed.map { |e| push_change_for(e) }
  $stderr.puts("push: #{unchanged.size} of #{entries.size} file(s) already bound at the same digest") if unchanged.any?

  if changes.empty?
    return success('site' => slug, 'branch' => branch, 'expected' => expected, 'prefix' => prefix,
                   'files' => entries.size, 'unchanged' => unchanged.size, 'saved' => false, 'changes' => [])
  end

  # Identical bytes anywhere in the tree are one upload; the API is content
  # addressed, so two logical paths can share one digest.
  by_digest = changed.group_by { |e| e['digest'] }
  results = upload_files(slug, by_digest.values.map { |group| group.first['file'] }, credential: credential)

  failed = results.reject { |r| r[:status] == 'ready' }
  if failed.any?
    failed.each { |r| emit(r) }
    return failure("#{failed.size} of #{results.size} upload(s) failed; nothing was saved", code: 'UPLOAD_FAILED')
  end

  mismatched = results.reject { |r| by_digest.key?(r[:digest]) }
  if mismatched.any?
    return failure("the server returned a digest that does not match the local bytes", code: 'DIGEST_MISMATCH',
                   body: { 'files' => mismatched.map { |r| r[:path] } })
  end

  # The fast path plan 30 is built around: bytes the platform already holds
  # anywhere, uploaded by nobody. Worth one line, because it is the difference
  # between a 28-file push that sends 28 files and one that sends 4.
  deduplicated = results.count { |r| r[:deduplicated] }
  if deduplicated.positive?
    $stderr.puts("push: #{deduplicated} of #{results.size} upload(s) were already on the platform " \
                 'under the same sha256, so no bytes were sent for them')
  end

  # The platform types bytes from content, not from the filename, so a file
  # called .png that holds JPEG bytes is delivered as asset.jpg. That used to
  # appear nowhere short of a browser's network log (slice G friction 15).
  results.each do |result|
    declared = changed.find { |e| e['file'] == result[:path] }&.fetch('media_type')
    served = result[:media_type]
    next if served.nil? || declared.nil? || served == declared
    $stderr.puts("push: #{File.basename(result[:path])} is #{served}, not the #{declared} its name claims " \
                 '-- the platform types bytes from content and serves it under that type')
  end

  tool_call(slug, 'save', { 'branch' => branch, 'expected' => expected,
                            'idempotency_key' => SecureRandom.uuid,
                            'message' => "push #{File.basename(dir)} (#{changes.size} assets)",
                            'changes' => changes }, credential: credential)
end

PREVIEW_POLL_INTERVAL = 2
# The six build states plus the two that say there is no hostname and none is
# coming (slice D, Mcp::ToolRegistry::V2_CONVENTIONS). Only queued/building are
# worth waiting on; everything else settles this command one way or the other.
PREVIEW_PENDING = %w[queued building].freeze
PREVIEW_FAILED = %w[invalid failed].freeze

# Neither of these is a build that will finish. `revoked` means every grant on
# this snapshot was withdrawn (save again for a new one); `unavailable` means
# the snapshot predates builds entirely.
PREVIEW_NO_HOSTNAME = {
  'revoked' => 'every preview of this snapshot was withdrawn; save again to mint a new hostname',
  'unavailable' => 'this snapshot predates builds, so it has no preview hostname'
}.freeze

# `ready` and `provisioning` are both "the build is done and it is good". They
# differ only in whether the wildcard certificate is installed on the host yet,
# which is a platform state no amount of polling changes -- so provisioning is
# terminal and successful, and says why the URL will not open.
PROVISIONING_NOTE = 'the build is ready, but the preview hostname cannot be opened until the ' \
                    '*.gxbsites.com wildcard certificate is installed on the host'

# Polls describe_site until the branch's preview build settles.
def cmd_wait_preview(slug, branch, timeout)
  deadline = Time.now + timeout

  loop do
    data, err = api_call(slug, 'describe_site', { 'branch' => branch })
    return fail_with(err) if err
    remember_branch_state(slug, data)

    entry = Array(data['branches']).find { |b| b.is_a?(Hash) && b['name'] == branch } || {}
    status = entry['preview_status'] || data['preview_status']
    # wait-preview polls describe_site, so it already holds everything the
    # second describe people ran straight after it was for (pc_6280b825,
    # pc_f4d60acf): the head the build stored, whether the forms script is in
    # it, and the URL the shell said the page is canonically at.
    payload = { 'site' => slug, 'branch' => branch, 'preview_status' => status,
                'preview_url' => entry['preview_url'] || data['preview_url'],
                'diagnostics' => entry['diagnostics'] || data['diagnostics'] || [],
                'head_preview' => entry['head_preview'] || data['head_preview'],
                'integrations' => entry['integrations'] || data['integrations'],
                'canonical_url' => data['canonical_url'] || entry['canonical_url'],
                'review' => entry['review'] }

    return success(payload) if status == 'ready'
    return success(payload.merge('message' => PROVISIONING_NOTE)) if status == 'provisioning'

    if PREVIEW_FAILED.include?(status)
      return failure("preview #{status} for #{slug}/#{branch}", code: status.upcase, body: payload)
    end
    if (note = PREVIEW_NO_HOSTNAME[status])
      return failure("preview #{status} for #{slug}/#{branch} -- #{note}", code: status.upcase, body: payload)
    end
    unless PREVIEW_PENDING.include?(status)
      return failure("this server reports preview_status #{status.inspect} for #{slug}/#{branch}",
                     code: status.nil? ? 'PREVIEW_MISSING' : 'PREVIEW_UNKNOWN', body: payload)
    end
    if Time.now >= deadline
      return failure("preview still #{status} for #{slug}/#{branch} after #{timeout}s", code: 'PREVIEW_TIMEOUT', body: payload)
    end

    sleep PREVIEW_POLL_INTERVAL
  end
end

# -----------------------------------------------------------------------------
# check: load a URL in agent-browser and report what broke
# -----------------------------------------------------------------------------

AGENT_BROWSER = ENV.fetch('SITES_CLI_BROWSER', 'agent-browser')

def agent_browser(session, *args)
  out, err, status = Open3.capture3(AGENT_BROWSER, '--session', session, *args, '--json')
  parsed = begin
    JSON.parse(out.lines.find { |l| l.start_with?('{') } || out)
  rescue JSON::ParserError
    nil
  end

  if parsed.nil?
    return [nil, api_error("#{AGENT_BROWSER} #{args.first} produced no JSON (exit #{status.exitstatus}): #{err.strip.empty? ? out.strip : err.strip}",
                           code: 'BROWSER_ERROR')]
  end
  return [nil, api_error("#{AGENT_BROWSER} #{args.first} failed: #{parsed['error']}", code: 'BROWSER_ERROR')] unless parsed['success']

  [parsed['data'] || {}, nil]
rescue Errno::ENOENT
  [nil, api_error("#{AGENT_BROWSER} is not on PATH -- see ~/notes/web-browsing.md", code: 'NO_BROWSER')]
end

# agent-browser reports console messages (`console`) and uncaught page errors
# (`errors`) separately; both are console errors as far as a page check is
# concerned, so they are merged into one list.
def collect_console_errors(console, errors)
  messages = Array(console['messages']).select { |m| m.is_a?(Hash) && m['type'] == 'error' }.map { |m| m['text'].to_s }
  messages + Array(errors['errors']).map { |e| e.is_a?(Hash) ? e['text'].to_s : e.to_s }
end

def collect_failed_requests(requests, ignore)
  Array(requests['requests']).filter_map do |r|
    next unless r.is_a?(Hash)
    status = r['status']
    failed = status.nil? || status.to_i >= 400
    next unless failed
    next if ignore.any? { |needle| r['url'].to_s.include?(needle) }
    { 'url' => r['url'], 'status' => status,
      'error' => r['errorText'] || r['failure'] || r['error'] }.compact
  end
end

# A blocked module script and a missing object look identical in a browser:
# an entry with no status, and nothing in the console (slice G friction 12).
# The two are told apart from outside the browser -- ask the object for itself
# with an Origin header and see whether it answers, and with what headers.
CORS_PROBE_LIMIT = 10

def probe_cross_origin(url, origin)
  uri = URI(url)
  req = Net::HTTP::Get.new(uri)
  req['Origin'] = origin
  req['Range'] = 'bytes=0-0' # never pull a whole 4 MB bundle to read its headers
  res = http_request(req, uri)
  { 'status' => res.code.to_i, 'access_control_allow_origin' => res['access-control-allow-origin'] }.compact
rescue *NETWORK_ERRORS => e
  { 'error' => "#{e.class}: #{e.message}" }
end

def diagnose_failed_requests(failures, page_url, limit: CORS_PROBE_LIMIT)
  page = begin URI(page_url) rescue nil end
  return failures unless page&.host

  origin = "#{page.scheme}://#{page.host}#{page.port && ![80, 443].include?(page.port) ? ":#{page.port}" : ''}"
  probed = 0

  failures.each do |failure|
    next if failure['status'] # the browser already got an answer; that is the answer
    break if probed >= limit
    target = begin URI(failure['url'].to_s) rescue nil end
    next unless target&.host && target.host != page.host
    probed += 1

    probe = probe_cross_origin(failure['url'], origin)
    failure['probe'] = probe
    if probe['error']
      failure['diagnosis'] = 'unreachable'
      failure['message'] = "the object could not be fetched from here either (#{probe['error']})"
    elsif probe['status'].to_i >= 400
      failure['diagnosis'] = 'http_error'
      failure['message'] = "the object itself answers HTTP #{probe['status']}"
    elsif probe['access_control_allow_origin'].nil?
      failure['diagnosis'] = 'cors_blocked'
      failure['message'] = "the object exists (HTTP #{probe['status']}) but sends no access-control-allow-origin " \
                           "for #{origin}, so the browser blocked it. This is bucket CORS, not a missing file."
    else
      failure['diagnosis'] = 'cors_ok'
      failure['message'] = "the object exists (HTTP #{probe['status']}) and allows " \
                           "#{probe['access_control_allow_origin']}, so the block is something else"
    end
  end
  failures
end

# A preview hostname that resolves but cannot finish a handshake is the missing
# *.gxbsites.com wildcard certificate, not a bad build (slice G, todo 531).
# Both delimiters: the host is <token>--<slug>.gxbsites.com since the domains
# worker's change, and grants minted before it are still <token>-<slug>.
PREVIEW_HOST = /\A[a-z2-7]{10,}--?[a-z0-9-]+\.gxbsites\.com\z/i

def tls_hint(url, message)
  return nil unless message.to_s.match?(/ERR_SSL|ERR_CERT|SSL_PROTOCOL|handshake/i)
  host = begin URI(url).host rescue nil end
  return nil unless host&.match?(PREVIEW_HOST)
  'this is a preview hostname and the *.gxbsites.com wildcard certificate is not installed on the host yet, ' \
    'so no client can complete a TLS handshake with it. The build itself is unaffected -- ' \
    '`sites-cli wait-preview SLUG` reports what it is.'
end

# -----------------------------------------------------------------------------
# What a page says about itself, read out of its own served bytes. Proving a
# rebuild matches its source used to be a 35-line extract.js and a normtext.py
# per agent, then a hand-rolled diff (pc_61361f8f).
# -----------------------------------------------------------------------------

def head_fields(html)
  head = document_parts(html).head
  metas = {}
  head.scan(/<meta\b[^>]*>/i) do |tag|
    key = tag[/\b(?:name|property)=["']([^"']+)["']/i, 1].to_s.downcase
    content = tag[/\bcontent=["']([^"']*)["']/i, 1]
    metas[key] = collapse(decode_entities(content)) if key && content
  end
  links = head.scan(/<link\b[^>]*>/i).map do |tag|
    [tag[/\brel=["']([^"']+)["']/i, 1].to_s.downcase, tag[/\bhref=["']([^"']+)["']/i, 1].to_s]
  end
  types = html.scan(LD_JSON_TAG).flatten.flat_map { |inner| ld_json_nodes(inner, [], 'page') }
              .map { |node| node['@type'] }.flatten.compact.sort.uniq

  { 'title' => collapse(decode_entities(html[%r{<title[^>]*>(.*?)</title>}mi, 1].to_s)),
    'description' => metas['description'],
    'canonical' => links.find { |rel, _| rel.split(/\s+/).include?('canonical') }&.last,
    'robots' => metas['robots'],
    'theme-color' => metas['theme-color'],
    'og:image' => metas['og:image'],
    'twitter:card' => metas['twitter:card'],
    'favicon' => links.find { |rel, _| rel.split(/\s+/).include?('icon') }&.last,
    'json-ld' => types.join(' ') }
end

def resource_counts(html)
  { 'images' => html.scan(/<img\b/i).size,
    'scripts' => html.scan(/<script\b[^>]*\bsrc=/i).size,
    'stylesheets' => html.scan(/<link\b[^>]*\brel=["'][^"']*stylesheet/i).size }
end

# Visible text, folded so that a curly quote, an em dash and a run of newlines
# are not a difference. What is left is what a reader would notice.
TEXT_FOLDS = { '’' => "'", '‘' => "'", '“' => '"', '”' => '"', '–' => '-', '—' => '-',
               '…' => '...', ' ' => ' ' }.freeze

# The elements a reader sees as a break. Keeping those breaks is what makes
# the diff point at one paragraph rather than at the whole page.
BLOCK_ELEMENTS = %w[p div section article header footer main nav aside blockquote figure figcaption
                    h1 h2 h3 h4 h5 h6 li dt dd tr td th pre form label button].freeze

def visible_text(html)
  body = document_parts(html).body
  stripped = body.gsub(%r{<(script|style|template)\b[^>]*>.*?</\1>}mi, ' ')
                 .gsub(%r{</(?:#{BLOCK_ELEMENTS.join('|')})>|<br\b[^>]*>}i, "\n")
                 .gsub(/<[^>]+>/m, ' ')
  text = decode_entities(stripped)
  TEXT_FOLDS.each { |from, to| text = text.gsub(from, to) }
  text.split("\n").map { |line| collapse(line) }.reject(&:empty?).join("\n")
end

# One block, then one sentence, then a hard wrap: the diff points at a phrase
# rather than at one very long line that differs somewhere.
def text_lines(text)
  text.split("\n").flat_map do |block|
    block.split(/(?<=[.!?])\s+/).flat_map do |sentence|
      sentence.scan(/\S.{0,90}(?:\s|\z)/).map(&:strip).reject(&:empty?)
    end
  end
end

# A plain LCS unified diff. No gem, and the only consumer is a person reading
# two versions of the same page.
def unified_diff(left, right, from:, to:)
  lcs = Array.new(left.size + 1) { Array.new(right.size + 1, 0) }
  left.each_index do |i|
    right.each_index do |j|
      lcs[i + 1][j + 1] = left[i] == right[j] ? lcs[i][j] + 1 : [lcs[i][j + 1], lcs[i + 1][j]].max
    end
  end

  lines = []
  i = left.size
  j = right.size
  while i.positive? || j.positive?
    if i.positive? && j.positive? && left[i - 1] == right[j - 1]
      lines << "  #{left[i - 1]}"
      i -= 1
      j -= 1
    elsif j.positive? && (i.zero? || lcs[i][j - 1] >= lcs[i - 1][j])
      lines << "+ #{right[j - 1]}"
      j -= 1
    else
      lines << "- #{left[i - 1]}"
      i -= 1
    end
  end
  lines.reverse!
  return [[], ''] if lines.none? { |line| line.start_with?('+', '-') }
  ["--- #{from}", "+++ #{to}", *lines].then { |all| [lines.select { |l| l.start_with?('+', '-') }, all.join("\n")] }
end

# What the browser is asked for once a page has settled. Kept apart from the
# console/network half so --against can gather it for a second URL without
# re-running the whole check.
def extract_page(session, url)
  nav, err = agent_browser(session, 'open', url)
  if err
    hint = tls_hint(url, err[:error])
    return [nil, err.merge(code: 'PREVIEW_TLS', error: "#{err[:error]} -- #{hint}")] if hint
    return [nil, err]
  end
  agent_browser(session, 'wait', '--load', 'networkidle')
  document, = agent_browser(session, 'get', 'html', 'html')
  [{ 'url' => nav['url'] || url, 'title' => nav['title'], 'html' => document&.dig('html').to_s }, nil]
end

def page_profile(html)
  { 'head' => head_fields(html), 'counts' => resource_counts(html), 'text' => visible_text(html) }
end

def profile_differences(left, right, ignore)
  lines = []
  left['head'].each_key do |field|
    before = left['head'][field].to_s
    after = right['head'][field].to_s
    lines << "#{field}: #{before.inspect} -> #{after.inspect}" unless before == after
  end
  left['counts'].each_key do |field|
    next if left['counts'][field] == right['counts'][field]
    lines << "#{field}: #{left['counts'][field]} -> #{right['counts'][field]}"
  end
  lines.reject { |line| ignore.any? { |needle| line.include?(needle) } }
end

# A PNG whose pixels are all one colour compresses to almost nothing, so bytes
# per pixel tells a painted page from an unpainted one without a decoder. The
# case this exists for wrote a 4.9 KB all-background image and reported success
# (pc_9e0ec6d6).
BLANK_SCREENSHOT_BYTES = 6 * 1024
BLANK_BYTES_PER_PIXEL = 1 / 2000.0

def png_dimensions(path)
  header = File.binread(path, 24)
  return nil unless header && header[0, 8] == "\x89PNG\r\n\x1A\n".b
  header[16, 8].unpack('N2')
rescue StandardError
  nil
end

def blank_screenshot_reason(path, full:)
  bytes = File.size(path)
  dimensions = png_dimensions(path)
  if dimensions
    width, height = dimensions
    pixels = width * height
    if pixels.positive? && bytes.to_f / pixels < BLANK_BYTES_PER_PIXEL
      return "#{bytes} bytes for #{width}x#{height} pixels is one flat colour: the page had not painted when " \
             'it was captured'
    end
  end
  return nil unless full && bytes < BLANK_SCREENSHOT_BYTES
  "#{bytes} bytes for a full-page capture is a blank image: the page had not painted when it was captured"
end

def cmd_check(url, width:, height:, screenshot:, ignore:, probe: true, against: nil, full: true)
  session = "sites-cli-#{SecureRandom.hex(4)}"
  result = nil
  exit_code = 0

  begin
    _blank, err = agent_browser(session, 'open')
    return fail_with(err) if err

    agent_browser(session, 'set', 'viewport', width.to_s, height.to_s)

    page, err = extract_page(session, url)
    return fail_with(err) if err

    console, = agent_browser(session, 'console')
    errors, = agent_browser(session, 'errors')
    requests, = agent_browser(session, 'network', 'requests')

    if screenshot
      FileUtils.mkdir_p(File.dirname(File.expand_path(screenshot)))
      # Full page by default: proving a rebuild matches its source needs the
      # whole page, and dropping to agent-browser for it cost seven commands
      # per page and lost this payload (pc_4ac898d8).
      agent_browser(session, 'screenshot', *(full ? ['--full'] : []), screenshot)
    end

    final_url = page['url']
    document = Array(requests&.dig('requests')).select { |r| r.is_a?(Hash) && r['url'] == final_url }.last
    failed = collect_failed_requests(requests || {}, ignore)
    diagnose_failed_requests(failed, final_url) if probe
    result = {
      'status' => document && document['status'],
      'console_errors' => collect_console_errors(console || {}, errors || {}),
      'failed_requests' => failed,
      'title' => page['title'],
      'url' => final_url
    }

    if screenshot
      path = File.expand_path(screenshot)
      result['screenshot'] = path
      if File.file?(path)
        result['screenshot_bytes'] = File.size(path)
        if (reason = blank_screenshot_reason(path, full: full))
          result['screenshot_blank'] = reason
          exit_code = 1
        end
      else
        result['screenshot_blank'] = 'the browser wrote no file'
        exit_code = 1
      end
    end

    if against
      other, err = extract_page(session, against)
      return fail_with(err) if err
      left = page_profile(page['html'])
      right = page_profile(other['html'])
      differences = profile_differences(left, right, ignore)
      text_changes, text_diff = unified_diff(text_lines(left['text']), text_lines(right['text']),
                                             from: final_url, to: other['url'])
      text_changes = text_changes.reject { |line| ignore.any? { |needle| line.include?(needle) } }
      result['against'] = { 'url' => other['url'], 'head' => right['head'], 'counts' => right['counts'] }
      result['head'] = left['head']
      result['counts'] = left['counts']
      result['differences'] = differences
      result['text_diff'] = text_changes.empty? ? '' : text_diff
      exit_code = 1 if differences.any? || text_changes.any?
    end
  ensure
    # Every orphan agent-browser session is a full Chrome that lives until
    # reboot (~/notes/web-browsing.md), so this closes even on an early return.
    # By name, never --all: seven of these run at once and --all is a
    # cross-agent kill (pc_8fe3d8b8, pc_412bc69b).
    agent_browser(session, 'close')
  end

  return 1 unless result
  emit(result)
  # The diagnosis is the whole point of running the probe, so say it in prose
  # too rather than making a person re-read the JSON to find it.
  result['failed_requests'].each do |failure|
    next unless failure['message']
    $stderr.puts("check: #{failure['url']} -- #{failure['message']}")
  end
  $stderr.puts("check: the screenshot is blank -- #{result['screenshot_blank']}") if result['screenshot_blank']
  if against
    Array(result['differences']).each { |line| $stderr.puts("check: #{line}") }
    $stderr.puts(result['text_diff']) unless result['text_diff'].to_s.empty?
    $stderr.puts("check: #{url} and #{against} agree on the head, the counts and the visible text") if
      Array(result['differences']).empty? && result['text_diff'].to_s.empty?
  end

  ok = result['console_errors'].empty? && result['failed_requests'].empty? &&
       (result['status'].nil? || result['status'].to_i < 400)
  ok && exit_code.zero? ? 0 : 1
end

# -----------------------------------------------------------------------------
# fragment: a full HTML document -> a versioned page body
#
# The shell owns <!doctype>, <html>, <head>, <body>, <title>, <meta>, the one
# import map and <main id="main">, so a page authored as a standalone file has
# to be taken apart before it can be saved. Slice G did that conversion by
# hand, twice, from a table in a report. This is that table as code: it drops
# the shell, harvests the head into config/metadata, rewrites every local
# assets/ reference into {{ asset: }}, and says what it did.
# -----------------------------------------------------------------------------

ASSET_ATTRIBUTES = %w[src href data-asset poster data-src data-poster data-image].freeze

ENTITIES = {
  'amp' => '&', 'lt' => '<', 'gt' => '>', 'quot' => '"', 'apos' => "'", 'nbsp' => ' ',
  'mdash' => "—", 'ndash' => "–", 'hellip' => "…",
  'rsquo' => "’", 'lsquo' => "‘", 'ldquo' => "“", 'rdquo' => "”"
}.freeze

def decode_entities(text)
  text.gsub(/&(#x[0-9a-fA-F]+|#\d+|[a-zA-Z]+);/) do
    whole = Regexp.last_match(0)
    token = Regexp.last_match(1)
    if token.downcase.start_with?('#x') then [token[2..].to_i(16)].pack('U')
    elsif token.start_with?('#') then [token[1..].to_i].pack('U')
    else ENTITIES.fetch(token.downcase, whole)
    end
  end
end

def collapse(text) = text.to_s.gsub(/\s+/, ' ').strip

# A reference the platform can bind: a relative (or root-relative) path under
# the asset prefix. Anything absolute belongs to somebody else's server.
def local_asset(reference, prefix)
  path = reference.to_s.strip.sub(%r{\A\./}, '').sub(%r{\A/}, '')
  return nil if reference.to_s.match?(%r{\A[a-z][a-z0-9+.-]*://}i) || reference.to_s.start_with?('//')
  path.start_with?(prefix) ? path : nil
end

def read_text(source)
  raw = source == '-' ? $stdin.read : (File.read(source) if File.file?(source))
  return [nil, api_error("no such file: #{source}", code: 'NO_FILE')] unless raw
  [raw, nil]
end

Parts = Struct.new(:head, :body, :full, :body_attributes)

def document_parts(html)
  head_match = html.match(%r{<head\b[^>]*>(.*?)</head>}mi)
  body_match = html.match(%r{<body\b([^>]*)>(.*?)</body>}mi)
  full = !!(head_match || body_match || html.match(/<!doctype/i) || html.match(/<html\b/i))

  body =
    if body_match then body_match[2]
    elsif head_match then html[head_match.end(0)..].to_s.sub(%r{</html>\s*\z}i, '')
    else html
    end
  Parts.new(head_match ? head_match[1] : '', body, full, body_match ? body_match[1].to_s.strip : '')
end

# Attribute names in source order, with their values. Good enough for the
# handful of things a <body> or <main> carries; this is a converter, not a
# parser, and anything it cannot read it reports rather than swallows.
def parse_attributes(text)
  text.to_s.scan(/([A-Za-z_:][-A-Za-z0-9_:.]*)(?:\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'>]+)))?/)
      .to_h { |name, dq, sq, bare| [name.downcase, dq || sq || bare] }
end

def attributes_to_s(attributes)
  attributes.map { |name, value| value.nil? ? " #{name}" : %( #{name}="#{value}") }.join
end

# The one font host the shell links (SiteDocument::FONT_STYLESHEET_ORIGIN), so
# a Google Fonts sheet has a home -- metadata.font_stylesheet -- rather than
# being dropped with the rest of the head.
GOOGLE_FONTS_ORIGIN = 'https://fonts.googleapis.com/'
# The platform emits its own analytics tag from the site's analytics key, so a
# hand-placed one is a second copy that double counts.
ANALYTICS_HOST = 'analytics.gxb.vc'

def scan_stylesheets_and_icons(markup, prefix, config, external)
  markup.scan(/<link\b[^>]*>/i) do |tag|
    rel = tag[/\brel=["']([^"']+)["']/i, 1].to_s.downcase.split(/\s+/)
    href = tag[/\bhref=["']([^"']+)["']/i, 1].to_s
    next if href.empty?
    if rel.include?('stylesheet')
      local = local_asset(href, prefix)
      if local
        config['stylesheets'] << local unless config['stylesheets'].include?(local)
      else
        external << href
      end
    elsif rel.include?('icon')
      local = local_asset(href, prefix)
      config['favicon'] = { 'url' => local } if local && !config.key?('favicon')
    end
  end
end

LD_JSON_TAG = %r{<script\b[^>]*\btype=["']application/ld\+json["'][^>]*>(.*?)</script>}mi

# metadata.schema is an array of plain nodes: the shell owns the @context and
# merges these into its own @graph, so a document that arrives as
# {"@context":…, "@graph":[…]} contributes its graph and nothing else
# (contract brief item 3).
def ld_json_nodes(inner, warnings, where)
  parsed = begin JSON.parse(inner) rescue nil end
  if parsed.nil?
    warnings << "a <script type=\"application/ld+json\"> in the #{where} is not valid JSON, so it was left alone"
    return []
  end
  nodes = parsed.is_a?(Array) ? parsed : (parsed['@graph'].is_a?(Array) ? parsed['@graph'] : [parsed])
  nodes.filter_map do |node|
    next warnings << "a JSON-LD node in the #{where} is not an object and was left alone" unless node.is_a?(Hash)
    node.reject { |key, _| key == '@context' }
  end
end

SCRIPT_TAG = %r{(<script\b[^>]*>)(.*?)</script>}mi

# What a config document says that a browser will punish later. Today there is
# one: Site::PublicConfig always routes favicon.url through a Cloudflare image
# transform, and those refuse SVG input -- so a declared SVG favicon validates,
# builds `ready`, and is a 415 on every page (slice G friction 3).
def config_warnings(config)
  return [] unless config.is_a?(Hash)
  url = config.dig('favicon', 'url') || config.dig('favicon', :url)
  return [] unless url.to_s.downcase.end_with?('.svg')
  ['a declared SVG favicon is an HTTP 415 on every page: the platform routes favicon.url through a ' \
   'Cloudflare image transform, and those refuse SVG input. The blob itself is fine -- rasterize it ' \
   '(rsvg-convert -w 512 -h 512 in.svg -o out.png), upload the raster, and declare the .png.']
end

def scan_scripts(markup, prefix, config, warnings)
  markup.scan(SCRIPT_TAG) do |tag, inner|
    type = tag[/\btype=["']([^"']+)["']/i, 1].to_s.downcase
    src = tag[/\bsrc=["']([^"']+)["']/i, 1]

    if type == 'importmap'
      parsed = begin JSON.parse(inner) rescue nil end
      if parsed.is_a?(Hash) && parsed['imports'].is_a?(Hash)
        parsed['imports'].each do |name, target|
          local = local_asset(target, prefix)
          if local
            config['imports'][name] = local
          else
            warnings << "import map entry #{name.inspect} points outside #{prefix} and was dropped: #{target}"
          end
        end
      else
        warnings << 'an inline import map could not be parsed as JSON; its entries were not carried into config.imports'
      end
    elsif type == 'module' && src
      local = local_asset(src, prefix)
      if local
        config['modules'] << local unless config['modules'].include?(local)
      else
        warnings << "module script points outside #{prefix} and was left in the body: #{src}"
      end
    end
  end
end

# A form posts to /f/<name>, /platform/forms-1.js writes the answer into
# [data-form-result] or #form-<name>-result, and a page with neither shows the
# visitor nothing at all and leaves the submit button disabled. Nothing said so
# anywhere: the build had no diagnostic, the checks were clean, and the form
# looked broken on a live practice's site (pc_0e2afbdd).
FORM_RESULT_ELEMENT = '<p data-form-result hidden></p>'

def form_names(body)
  body.scan(%r{<form\b[^>]*\baction=["']/f/([^"'?#/]+)}i).flatten
end

def form_result_missing(body, name)
  !body.match?(/\bdata-form-result\b/i) && !body.match?(/\bid=["']form-#{Regexp.escape(name)}-result["']/i)
end

# Inserted after the </form> that closes this form, because that is where the
# script looks and where a person reads it. Forms do not nest.
def insert_form_result(body, name)
  open_at = body.index(%r{<form\b[^>]*\baction=["']/f/#{Regexp.escape(name)}}i)
  return body unless open_at
  close_at = body.index(%r{</form>}i, open_at)
  return body unless close_at
  after = close_at + body[close_at..][/\A<\/form>/i].length
  body[0...after] + "\n" + FORM_RESULT_ELEMENT + body[after..]
end

Conversion = Struct.new(:prefix, :wrap_body, :add_form_result, :lift_json_ld, keyword_init: true)

# rubocop:disable Metrics/AbcSize
def html_to_fragment(html, prefix: 'assets/', wrap_body: false, add_form_result: false, lift_json_ld: false)
  options = Conversion.new(prefix: prefix, wrap_body: wrap_body, add_form_result: add_form_result,
                           lift_json_ld: lift_json_ld)
  notes = []
  warnings = []
  config = { 'stylesheets' => [], 'modules' => [], 'imports' => {} }
  metadata = {}

  parts = document_parts(html)
  head = parts.head
  body = parts.body
  notes << 'dropped the document shell (<!doctype>, <html>, <head>, <body>) -- the site shell owns it' if parts.full

  if (m = html.match(%r{<title[^>]*>(.*?)</title>}mi))
    metadata['title'] = collapse(decode_entities(m[1]))
    notes << "<title> -> metadata.title (#{metadata['title'].inspect})"
  end
  head.scan(/<meta\b[^>]*>/i) do |tag|
    name = tag[/\bname=["']([^"']+)["']/i, 1].to_s.downcase
    content = tag[/\bcontent=["']([^"']*)["']/i, 1]
    next unless content
    case name
    when 'description'
      metadata['description'] = collapse(decode_entities(content))
      notes << '<meta name="description"> -> metadata.description'
    when 'robots'
      next unless content.downcase.include?('noindex')
      metadata['noindex'] = true
      notes << '<meta name="robots" content="noindex"> -> metadata.noindex'
    end
  end

  external_styles = []
  scan_stylesheets_and_icons("#{head}\n#{body}", prefix, config, external_styles)
  scan_scripts("#{head}\n#{body}", prefix, config, warnings)
  notes << "<link rel=\"stylesheet\"> -> config.stylesheets (#{config['stylesheets'].join(', ')})" if config['stylesheets'].any?
  notes << "<script type=\"module\" src> -> config.modules (#{config['modules'].join(', ')})" if config['modules'].any?
  notes << "<script type=\"importmap\"> -> config.imports (#{config['imports'].keys.join(', ')}) -- the shell emits the one import map" if config['imports'].any?
  notes << "<link rel=\"icon\"> -> config.favicon.url (#{config.dig('favicon', 'url')})" if config['favicon']
  external_styles.each do |href|
    if href.start_with?(GOOGLE_FONTS_ORIGIN)
      metadata['font_stylesheet'] = href
      notes << "Google Fonts stylesheet -> metadata.font_stylesheet (#{href}) -- the one font host the shell links"
    else
      warnings << "external stylesheet #{href} was dropped: config.stylesheets must name an asset in the same " \
                  "snapshot, and metadata.font_stylesheet takes #{GOOGLE_FONTS_ORIGIN} URLs only. Upload it, or " \
                  'accept that the page ships without it.'
    end
  end
  warnings.concat(config_warnings(config))

  # The head is gone wholesale, so anything in it worth keeping has to be
  # carried out first; the body keeps only what the shell does not own.
  css = +''
  head.scan(%r{<style\b[^>]*>(.*?)</style>}mi) { |inner,| css << inner << "\n" }
  body = body.gsub(%r{<style\b[^>]*>(.*?)</style>}mi) { css << Regexp.last_match(1) << "\n"; '' }
  head.scan(SCRIPT_TAG) do |tag, inner|
    type = tag[/\btype=["']([^"']+)["']/i, 1].to_s.downcase
    next if %w[importmap application/ld+json].include?(type) || tag.match?(/\bsrc=/i) || inner.strip.empty?
    warnings << 'an inline <script> in <head> was dropped with the rest of the head. ' \
                'Put it in the body, or upload it and name it in config.modules.'
  end

  # Structured data has a home now: metadata.schema, merged into the shell's
  # own @graph (contract brief item 3). The head's copy moves without being
  # asked; the body's is the agent's own tag, so it is named and only moved on
  # request (pc_c8a45696, andysibley section 6 item 5).
  schema = []
  head.scan(LD_JSON_TAG) { |inner,| schema.concat(ld_json_nodes(inner, warnings, 'head')) }
  notes << "<script type=\"application/ld+json\"> in <head> -> metadata.schema (#{schema.size} node(s))" if schema.any?
  body_schema_count = 0
  body = body.gsub(LD_JSON_TAG) do
    nodes = ld_json_nodes(Regexp.last_match(1), warnings, 'body')
    if options.lift_json_ld
      schema.concat(nodes)
      body_schema_count += nodes.size
      ''
    else
      warnings << "this page carries #{nodes.size} JSON-LD node(s) in its body as a <script>. Page structured " \
                  'data belongs in metadata.schema, where the shell merges it into the one @graph; ' \
                  'rerun with --lift-json-ld to move it there.'
      Regexp.last_match(0)
    end
  end
  notes << "<script type=\"application/ld+json\"> in the body -> metadata.schema (#{body_schema_count} node(s))" if body_schema_count.positive?
  metadata['schema'] = schema if schema.any?

  if css.strip.empty?
    css = nil
  else
    css = css.strip
    notes << "inline <style> -> the page document's css (#{css.bytesize} bytes)"
    if css.bytesize > 8192
      warnings << "that is #{css.bytesize} bytes of CSS on one page. Site-wide styling belongs in an uploaded " \
                  'asset named by config.stylesheets, not in every page document.'
    end
  end

  # The platform emits the analytics tag itself from the site's own key, so a
  # carried-over one counts every visit twice (pc_8a7753c8). A head one goes
  # with the head; a body one has to be taken out by name.
  analytics = head.scan(/<script\b[^>]*\bsrc=["'][^"']*#{Regexp.escape(ANALYTICS_HOST)}/i).size
  body = body.gsub(SCRIPT_TAG) do |whole|
    tag = Regexp.last_match(1)
    type = tag[/\btype=["']([^"']+)["']/i, 1].to_s.downcase
    src = tag[/\bsrc=["']([^"']+)["']/i, 1]
    if src.to_s.include?(ANALYTICS_HOST)
      analytics += 1
      ''
    elsif type == 'importmap' || (type == 'module' && src && local_asset(src, prefix))
      ''
    else
      whole
    end
  end
  notes << "dropped #{analytics} #{ANALYTICS_HOST} tag(s) -- the shell emits the site's own" if analytics.positive?
  body = body.gsub(/<link\b[^>]*>/i) do |tag|
    rel = tag[/\brel=["']([^"']+)["']/i, 1].to_s.downcase.split(/\s+/)
    (rel & %w[stylesheet icon preconnect preload dns-prefetch manifest]).any? ? '' : tag
  end

  head_scripts, body_scripts = [head, body].map do |markup|
    markup.scan(/<script\b[^>]*\bsrc=["']([^"']+)["'][^>]*>/i).flatten
          .reject { |src| local_asset(src, prefix) || src.include?(ANALYTICS_HOST) }.uniq
  end
  if head_scripts.any?
    warnings << "third-party script(s) in <head> went with the head: #{head_scripts.join(', ')}. The shell owns " \
                'the head, so put one in the body if the page needs it.'
  end
  if body_scripts.any?
    warnings << "third-party script(s) left in the body, which will load from someone else's origin on every " \
                "page view: #{body_scripts.join(', ')}"
  end

  before_skip = body
  body = body.sub(%r{<a\b[^>]*href=["']#main["'][^>]*>.*?</a>}mi, '')
  notes << 'dropped the skip link -- the shell emits its own' unless body == before_skip

  if (open_tag = body[/<main\b[^>]*>/i])
    main_attributes = parse_attributes(open_tag[/\A<main\b(.*?)>\z/mi, 1])
    dropped_id = main_attributes.delete('id')
    body = body.sub(open_tag) { "<div#{attributes_to_s(main_attributes)}>" }
    body = body.sub(%r{</main>(?!.*</main>)}mi, '</div>')
    notes << '<main> -> <div> -- the shell already emits <main id="main">' \
             "#{main_attributes.any? ? ", carrying #{main_attributes.keys.join(', ')} onto the div" : ''}" \
             "#{dropped_id ? " and dropping id=#{dropped_id.inspect}" : ''}"
  end

  referenced = []
  pattern = /\b(#{ASSET_ATTRIBUTES.join('|')})=["'](?:\.?\/)?(#{Regexp.escape(prefix)}[^"'{}\s]*)["']/i
  body = body.gsub(pattern) do
    attribute = Regexp.last_match(1)
    path = Regexp.last_match(2)
    referenced << path
    %(#{attribute}="{{ asset:#{path} }}")
  end
  referenced.uniq!
  notes << "rewrote #{referenced.size} reference(s) to {{ asset: }} (#{referenced.join(', ')})" if referenced.any?

  # Everything the source's <body> tag carried. Losing a body class changed
  # font smoothing, the page background and the default text colour on twelve
  # pages of a real site, and every check was clean (pc_b5376189).
  body_attributes = parse_attributes(parts.body_attributes)
  if body_attributes.any?
    listed = body_attributes.map { |name, value| value.nil? ? name : "#{name}=#{value.inspect}" }.join(' ')
    if options.wrap_body
      body = "<div#{attributes_to_s(body_attributes)}>\n#{body.strip}\n</div>"
      notes << "<body #{listed}> -> a wrapper <div> carrying the same attributes"
      warnings << 'a background utility on the wrapper paints over any descendant at a negative z-index, ' \
                  'which <body> did not. If the page has decorative layers behind the content, put the ' \
                  "background on the body element through the page's own css instead."
    else
      warnings << "the <body> carried #{listed}, and a fragment has no <body> to put it on -- those styles are " \
                  'lost on every page. Rerun with --wrap-body to re-wrap the fragment in a <div> carrying them, ' \
                  "or move them onto the body element through the page's own css."
    end
  end

  if body.match?(/\bsrcset=["'][^"']*#{Regexp.escape(prefix)}/i)
    warnings << 'srcset is not rewritten: bind each candidate by hand, or use one src.'
  end
  if body.match?(%r{<form\b[^>]*action=["']/f/}i) && body.match?(/addEventListener\(\s*["']submit["']/i) &&
     !body.match?(/stopPropagation\s*\(/)
    warnings << 'this page binds its own submit handler on a /f/ form. The platform injects ' \
                '/platform/forms-1.js, which binds a document-level submit listener too, so one click ' \
                'posts twice. Call event.stopPropagation() next to event.preventDefault().'
  end
  form_names(body).uniq.each do |name|
    next unless form_result_missing(body, name)
    if options.add_form_result
      body = insert_form_result(body, name)
      notes << "inserted #{FORM_RESULT_ELEMENT} after the /f/#{name} form -- /platform/forms-1.js writes its answer there"
    else
      warnings << "this page posts to /f/#{name} and carries no [data-form-result] and no " \
                  "#form-#{name}-result element. /platform/forms-1.js writes the server's answer into one of " \
                  'those and does nothing without one, so the visitor sees no message and a submit button ' \
                  "left disabled. Add an element with either marker, or rerun with --add-form-result to put " \
                  "#{FORM_RESULT_ELEMENT} after the form."
    end
  end

  assets = (referenced + config['stylesheets'] + config['modules'] + config['imports'].values +
            [config.dig('favicon', 'url')]).compact.uniq.sort

  { 'format' => 'html', 'metadata' => metadata, 'body' => body.strip, 'css' => css,
    'config' => config.reject { |_, v| v.respond_to?(:empty?) && v.empty? },
    'assets' => assets, 'notes' => notes, 'warnings' => warnings }.compact
end
# rubocop:enable Metrics/AbcSize

# The notes and the warnings go to stderr so stdout stays exactly one JSON
# envelope, whether this ran as `fragment` or inside `save --html`.
def report_fragment(result, label = 'fragment')
  Array(result['notes']).each { |line| $stderr.puts("#{label}: #{line}") }
  Array(result['warnings']).each { |line| $stderr.puts("#{label}: warning: #{line}") }
end

# The page put a conversion turns into. `changes` is this array now rather than
# a list of English sentences, so twelve documents can be appended into one
# file and saved in one call (pc_b36b3b9f); the sentences moved to `notes`.
def fragment_page_change(fragment, page_key, title: nil, extra_metadata: nil)
  metadata = fragment['metadata'].dup
  metadata.merge!(extra_metadata) if extra_metadata
  metadata['title'] = title if title
  if metadata['title'].to_s.strip.empty?
    return [nil, api_error("the document for #{page_key} has no <title>, and a page needs metadata.title: " \
                           'pass --title, or --metadata a JSON object carrying one', code: 'USAGE')]
  end

  document = { 'format' => 'html', 'metadata' => metadata, 'body' => fragment['body'] }
  document['css'] = fragment['css'] if fragment['css']
  [{ 'op' => 'put', 'kind' => 'page', 'key' => page_key, 'document' => document }, nil]
end

def cmd_fragment(file, prefix:, page_key:, title:, append_to:, wrap_body:, add_form_result:, lift_json_ld:)
  html, err = read_text(file)
  return fail_with(err) if err
  result = html_to_fragment(html, prefix: prefix, wrap_body: wrap_body,
                            add_form_result: add_form_result, lift_json_ld: lift_json_ld)

  changes = []
  if page_key
    change, err = fragment_page_change(result, page_key, title: title)
    return fail_with(err) if err
    changes << change
  elsif title
    return failure('--title needs --page KEY: without a route there is no page document to title', code: 'USAGE')
  end
  result['changes'] = changes
  report_fragment(result)
  $stderr.puts('fragment: pass --page KEY to emit the `put page` change save takes; without it `changes` is empty') if changes.empty?

  if append_to
    total, err = append_changes(append_to, changes)
    return fail_with(err) if err
    $stderr.puts("fragment: appended #{changes.size} change(s) to #{append_to} (#{total} in the file) -- " \
                 "`sites-cli save SLUG --changes #{append_to}` saves them all in one call")
  end
  success(result)
end

# One file a loop appends to, so converting twelve documents and saving once is
# a shell loop rather than twelve snapshots and twelve builds.
def append_changes(path, changes)
  existing = []
  if File.file?(path)
    loaded, err = json_file(path, '--append-changes')
    return [nil, err] if err
    existing = loaded.is_a?(Hash) ? Array(loaded['changes']) : Array(loaded)
  end
  merged = existing + changes
  File.write(path, JSON.pretty_generate(merged))
  [merged.size, nil]
end

# -----------------------------------------------------------------------------
# save builds one changes array out of as many documents as the command names.
#
# Twelve pages used to be twelve commands, twelve snapshots and twelve builds,
# because `--page KEY --html FILE` took one page and `--changes` wanted an array
# whose envelope lived only in the Ruby registry (pc_b36b3b9f). These flags
# carry their own operands and keep their order, which opt() cannot do: it
# plucks a flag out of argv wherever it is, and then nothing says which --html
# belongs to which --page.
# -----------------------------------------------------------------------------

SAVE_DOCUMENT_FLAGS = {
  '--page' => 1, '--html' => 1, '--markdown' => 1, '--title' => 1, '--metadata' => 1,
  '--config' => 1, '--collection' => 2, '--redirect' => 2, '--delete' => 2, '--asset' => 2
}.freeze

# Site::Versioned::OPS and Mcp::ToolRegistry::KINDS. Checked locally so a typo
# costs no round trip, the same rule an unknown --flag gets.
CHANGE_KINDS = %w[page layout include collection redirect config asset].freeze
DIGEST_SHAPE = /\A[0-9a-f]{64}\z/i

def scan_save_documents(argv)
  taken = []
  index = 0
  while index < argv.length
    arity = SAVE_DOCUMENT_FLAGS[argv[index]]
    unless arity
      index += 1
      next
    end
    operands = argv[index + 1, arity] || []
    if operands.size < arity || operands.any? { |value| SAVE_DOCUMENT_FLAGS.key?(value) }
      return [nil, api_error("#{argv[index]} takes #{arity} value(s): #{save_flag_usage(argv[index])}", code: 'USAGE')]
    end
    taken << [argv[index], operands]
    argv.slice!(index, arity + 1)
  end
  [taken, nil]
end

def save_flag_usage(flag)
  { '--page' => '--page KEY', '--html' => '--html FILE', '--markdown' => '--markdown FILE',
    '--title' => '--title TEXT', '--metadata' => '--metadata FILE', '--config' => '--config FILE',
    '--collection' => '--collection KEY FILE', '--redirect' => '--redirect FROM TO',
    '--delete' => '--delete KIND KEY', '--asset' => '--asset KEY FILE-or-DIGEST' }.fetch(flag, flag)
end

# A markdown page is its own body: no conversion, no shell to drop, and the
# title comes from --title or the document's own first H1.
def markdown_page_change(file, page_key, title, extra_metadata)
  text, err = read_text(file)
  return [nil, err] if err
  metadata = {}
  metadata.merge!(extra_metadata) if extra_metadata
  metadata['title'] = title if title
  metadata['title'] ||= collapse(text[/^\#\s+(.+)$/, 1].to_s)
  if metadata['title'].to_s.strip.empty?
    return [nil, api_error("#{File.basename(file)} has no leading # heading, and a page needs metadata.title: " \
                           'pass --title', code: 'USAGE')]
  end
  [{ 'op' => 'put', 'kind' => 'page', 'key' => page_key,
     'document' => { 'format' => 'markdown', 'metadata' => metadata, 'body' => text } }, nil]
end

def load_object(file, what)
  loaded, err = json_file(file, what)
  return [nil, err] if err
  return [nil, api_error("#{what} must contain a JSON object", code: 'BAD_JSON')] unless loaded.is_a?(Hash)
  [loaded, nil]
end

# rubocop:disable Metrics/AbcSize
def build_save_changes(taken, prefix:, wrap_body: false, add_form_result: false, lift_json_ld: false)
  pages = []
  items = []
  config_file = nil
  current = nil

  taken.each do |flag, operands|
    case flag
    when '--page'
      current = { 'key' => operands[0] }
      pages << current
      items << [:page, current]
    when '--html', '--markdown', '--title', '--metadata'
      unless current
        return [nil, api_error("#{flag} needs a --page KEY before it, the route to put the document at " \
                               '(e.g. --page / --html index.html)', code: 'USAGE')]
      end
      key = flag.delete_prefix('--')
      if current.key?(key)
        return [nil, api_error("--page #{current['key']} was given #{flag} twice", code: 'USAGE')]
      end
      current[key] = operands[0]
    when '--config'
      return [nil, api_error('save takes one --config document, not two', code: 'USAGE')] if config_file
      config_file = operands[0]
    when '--collection', '--redirect', '--delete', '--asset'
      items << [flag.delete_prefix('--').to_sym, operands]
    end
  end

  missing = pages.find { |page| !page.key?('html') && !page.key?('markdown') }
  if missing
    return [nil, api_error("--page #{missing['key']} has no document: give it --html FILE or --markdown FILE",
                           code: 'USAGE')]
  end

  # Convert first, because the config carry needs every page's head.
  pages.each do |page|
    next unless page['html']
    html, err = read_text(page['html'])
    return [nil, err] if err
    page['fragment'] = html_to_fragment(html, prefix: prefix, wrap_body: wrap_body,
                                        add_form_result: add_form_result, lift_json_ld: lift_json_ld)
    report_fragment(page['fragment'], "save #{page['key']}")
  end

  changes = []
  config_change, err = build_config_change(config_file, pages)
  return [nil, err] if err
  changes << config_change if config_change

  items.each do |type, payload|
    change, err = render_save_item(type, payload)
    return [nil, err] if err
    changes << change
  end
  [changes, nil]
end
# rubocop:enable Metrics/AbcSize

def render_save_item(type, payload)
  case type
  when :page
    extra = nil
    if payload['metadata']
      extra, err = load_object(payload['metadata'], '--metadata')
      return [nil, err] if err
    end
    if payload['markdown']
      markdown_page_change(payload['markdown'], payload['key'], payload['title'], extra)
    else
      fragment_page_change(payload['fragment'], payload['key'], title: payload['title'], extra_metadata: extra)
    end
  when :collection
    document, err = load_object(payload[1], '--collection')
    return [nil, err] if err
    [{ 'op' => 'put', 'kind' => 'collection', 'key' => payload[0],
       'document' => document['document'].is_a?(Hash) ? document['document'] : document }, nil]
  when :redirect
    [{ 'op' => 'put', 'kind' => 'redirect', 'key' => payload[0], 'document' => { 'to' => payload[1] } }, nil]
  when :delete
    kind = payload[0]
    unless CHANGE_KINDS.include?(kind)
      return [nil, api_error("--delete takes one of #{CHANGE_KINDS.join(', ')}, not #{kind.inspect}", code: 'USAGE')]
    end
    [{ 'op' => 'delete', 'kind' => kind, 'key' => payload[1] }, nil]
  when :asset
    key, value = payload
    if value.match?(DIGEST_SHAPE)
      [{ 'op' => 'put', 'kind' => 'asset', 'key' => key, 'digest' => value.downcase }, nil]
    elsif File.file?(value)
      # save binds a digest; it never sends bytes. Saying so here is cheaper
      # than a 422 unknown_asset after the snapshot is made.
      $stderr.puts("save: #{key} is bound to the sha256 of #{value}. `save` binds digests and uploads nothing -- " \
                   "if the platform has never seen these bytes, `sites-cli upload SLUG #{value}` (or `push`) first.")
      [{ 'op' => 'put', 'kind' => 'asset', 'key' => key, 'digest' => sha256_file(value) }, nil]
    else
      [nil, api_error("--asset #{key} takes a sha256 or a local file, and #{value.inspect} is neither",
                      code: 'NO_FILE')]
    end
  end
end

# A config document the conversions found keys for gets them, but only for keys
# the file does not declare at all -- an explicit "stylesheets": [] is a
# declaration and wins.
def build_config_change(config_file, pages)
  fragments = pages.filter_map { |page| page['fragment'] }
  unless config_file
    declaring = fragments.select { |fragment| fragment['config'].any? }
    if declaring.any?
      keys = declaring.flat_map { |fragment| fragment['config'].keys }.uniq
      $stderr.puts("save: the document(s) declare #{keys.join(', ')}, and no --config was given -- those " \
                   'stylesheets, modules and imports will not load until a config document names them.')
    end
    return [nil, nil]
  end

  loaded, err = load_object(config_file, '--config')
  return [nil, err] if err
  config = loaded['document'].is_a?(Hash) ? loaded['document'] : loaded

  # Twelve pages can name twelve different stylesheets, so the union across
  # every conversion is what a single config document has to hold.
  found = {}
  fragments.each do |fragment|
    fragment['config'].each do |key, value|
      case value
      when Array then found[key] = (found[key] || []) | value
      when Hash then found[key] = (found[key] || {}).merge(value)
      else found[key] ||= value
      end
    end
  end
  added = []
  found.each do |key, value|
    next if config.key?(key)
    config[key] = value
    added << key
  end
  $stderr.puts("save: carried #{added.join(', ')} from the converted document(s) into the config document") if added.any?
  already_said = fragments.flat_map { |fragment| Array(fragment['warnings']) }
  config_warnings(config).each { |line| $stderr.puts("save: warning: #{line}") unless already_said.include?(line) }
  [{ 'op' => 'put', 'kind' => 'config', 'document' => config }, nil]
end

# -----------------------------------------------------------------------------
# Argument parsing
# -----------------------------------------------------------------------------

def opt(argv, flag)
  i = argv.index(flag)
  return nil unless i
  argv.delete_at(i)
  argv.delete_at(i)
end

def opt_all(argv, flag)
  values = []
  while (value = opt(argv, flag))
    values << value
  end
  values
end

def flag?(argv, flag)
  i = argv.index(flag)
  return false unless i
  argv.delete_at(i)
  true
end

def unknown_flags(argv, command)
  leftover = argv.select { |a| a.start_with?('--') }
  return nil if leftover.empty?
  api_error("unknown option(s) for #{command}: #{leftover.join(' ')}", code: 'USAGE')
end

# --json FILE (or --json - for stdin) supplies the whole arguments object for
# a tool; explicit flags override individual keys on top of it.
def json_arguments(argv)
  source = opt(argv, '--json')
  return [{}, nil] unless source

  raw = if source == '-'
          $stdin.read
        elsif File.file?(source)
          File.read(source)
        end
  return [nil, api_error("no such file: #{source}", code: 'NO_FILE')] unless raw

  parsed = JSON.parse(raw)
  return [nil, api_error('--json must contain a JSON object', code: 'BAD_JSON')] unless parsed.is_a?(Hash)
  [parsed, nil]
rescue JSON::ParserError => e
  [nil, api_error("--json is not valid JSON: #{e.message}", code: 'BAD_JSON')]
end

def json_file(source, what)
  raw = if source == '-'
          $stdin.read
        elsif File.file?(source)
          File.read(source)
        end
  return [nil, api_error("no such file: #{source}", code: 'NO_FILE')] unless raw
  [JSON.parse(raw), nil]
rescue JSON::ParserError => e
  [nil, api_error("#{what} is not valid JSON: #{e.message}", code: 'BAD_JSON')]
end

def split_list(values)
  values.flat_map { |v| v.to_s.split(',') }.map(&:strip).reject(&:empty?)
end

