# Versioned tools whose arguments are all flags, so one table drives them.
def run_v2(command, argv)
  slug = argv.shift
  return failure("#{command} requires SLUG", code: 'USAGE') unless slug

  base, err = json_arguments(argv)
  return fail_with(err) if err

  case command
  when 'read'
    branch = opt(argv, '--branch')
    fields = opt_all(argv, '--fields')
    lines = opt(argv, '--lines')
    at = opt(argv, '--at')
    keys = split_list(opt_all(argv, '--keys'))
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    kind = argv.shift || base['kind']
    key = argv.shift || base['key']
    keys = Array(base['keys']) if keys.empty? && base['keys']
    return failure('read requires SLUG KIND [KEY]', code: 'USAGE') unless kind
    # The batch form is asset-only and answers {key => digest} for the ones
    # that are bound, which is how `push` skips files that have not changed.
    return failure('--keys reads many assets at once, so it only takes kind "asset"', code: 'USAGE') if keys.any? && kind != 'asset'

    args = base.merge('kind' => kind)
    if keys.any?
      args['keys'] = keys
      args.delete('key')
    elsif key
      args['key'] = key
    end
    args['branch'] = branch if branch
    args['fields'] = split_list(fields) if fields.any?
    if lines
      parsed = split_list([lines])
      return failure('--lines takes two integers, e.g. --lines 1,40', code: 'USAGE') unless parsed.size == 2 && parsed.all? { |n| n.match?(/\A\d+\z/) }
      args['lines'] = parsed.map(&:to_i)
    end
    args['at'] = at if at
    # A historical read reports the snapshot it read as `expected`, under the
    # branch it resolved -- remembering that would hand the next save a token
    # for a snapshot the branch is not on.
    tool_call(slug, 'read', args, remember: args['at'].nil?)

  when 'save'
    # The document flags come out first and in order: which --html belongs to
    # which --page is positional, and opt() would lose it.
    taken, err = scan_save_documents(argv)
    return fail_with(err) if err

    branch = opt(argv, '--branch') || base['branch'] || DEFAULT_BRANCH
    expected_flag = opt(argv, '--expected') || base['expected']
    idempotency = opt(argv, '--idempotency-key') || base['idempotency_key'] || SecureRandom.uuid
    message = opt(argv, '--message') || base['message']
    changes_file = opt(argv, '--changes')
    prefix = opt(argv, '--prefix') || 'assets/'
    wrap_body = flag?(argv, '--wrap-body')
    add_form_result = flag?(argv, '--add-form-result')
    lift_json_ld = flag?(argv, '--lift-json-ld')
    dry_run = flag?(argv, '--dry-run')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    changes = base['changes']
    if changes_file
      if taken.any?
        return failure("save takes --changes or the document flags (#{SAVE_DOCUMENT_FLAGS.keys.join(' ')}), " \
                       'not both: one of them would have to win', code: 'USAGE')
      end
      loaded, err = json_file(changes_file, '--changes')
      return fail_with(err) if err
      changes = loaded.is_a?(Hash) ? loaded['changes'] : loaded
    elsif taken.any?
      built, err = build_save_changes(taken, prefix: prefix, wrap_body: wrap_body,
                                      add_form_result: add_form_result, lift_json_ld: lift_json_ld)
      return fail_with(err) if err
      changes = built
    end
    unless changes.is_a?(Array)
      return failure('save requires --changes FILE|- (a JSON array of change objects), or document flags: ' \
                     '--page KEY --html FILE, --markdown FILE, --config FILE, --collection KEY FILE, ' \
                     '--redirect FROM TO, --delete KIND KEY, --asset KEY FILE-or-DIGEST, repeatable and ' \
                     'in any combination',
                     code: 'USAGE')
    end

    expected, err = resolve_expected(slug, branch, expected_flag)
    return fail_with(err) if err

    args = base.merge('branch' => branch, 'expected' => expected,
                      'idempotency_key' => idempotency, 'changes' => changes)
    args['message'] = message if message
    args['dry_run'] = true if dry_run
    # A rehearsal makes no snapshot, so it leaves no local state either: the
    # head it echoes is the one already remembered.
    tool_call(slug, 'save', args, remember: !dry_run)

  when 'create-branch'
    from = opt(argv, '--from') || base['from']
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    name = argv.shift || base['name']
    return failure('create-branch requires SLUG NAME', code: 'USAGE') unless name

    args = base.merge('name' => name)
    args['from'] = from if from
    tool_call(slug, 'create_branch', args)

  # Takes a branch out of service. Nothing is deleted and no asset URL stops
  # working; it stops counting against the site's quota (slice E).
  when 'archive-branch'
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    name = argv.shift || base['name']
    return failure('archive-branch requires SLUG NAME', code: 'USAGE') unless name
    tool_call(slug, 'archive_branch', base.merge('name' => name))

  when 'diff'
    branch = opt(argv, '--branch')
    against = opt(argv, '--against')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    args = base.dup
    args['branch'] = branch if branch
    args['against'] = against if against
    tool_call(slug, 'diff', args)

  when 'merge-live'
    branch = opt(argv, '--branch') || base['branch'] || DEFAULT_BRANCH
    expected_flag = opt(argv, '--expected') || base['expected']
    expected_live = opt(argv, '--expected-live') || base['expected_live']
    idempotency = opt(argv, '--idempotency-key') || base['idempotency_key'] || SecureRandom.uuid
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    return failure('merge-live requires --expected-live ID (describe_site.live.publication, or "absent")', code: 'USAGE') unless expected_live

    expected, err = resolve_expected(slug, branch, expected_flag)
    return fail_with(err) if err

    tool_call(slug, 'merge_live', base.merge('branch' => branch, 'expected' => expected,
                                             'expected_live' => expected_live, 'idempotency_key' => idempotency))

  when 'resolve-merge'
    proposal = opt(argv, '--proposal') || base['merge_proposal']
    resolutions_file = opt(argv, '--resolutions')
    idempotency = opt(argv, '--idempotency-key') || base['idempotency_key'] || SecureRandom.uuid
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    return failure('resolve-merge requires --proposal TOKEN', code: 'USAGE') unless proposal

    resolutions = base['resolutions']
    if resolutions_file
      loaded, err = json_file(resolutions_file, '--resolutions')
      return fail_with(err) if err
      resolutions = loaded.is_a?(Hash) ? loaded['resolutions'] : loaded
    end
    return failure('resolve-merge requires --resolutions FILE|- (a JSON array)', code: 'USAGE') unless resolutions.is_a?(Array)

    tool_call(slug, 'resolve_merge', base.merge('merge_proposal' => proposal, 'resolutions' => resolutions,
                                                'idempotency_key' => idempotency))

  when 'history'
    branch = opt(argv, '--branch')
    limit = opt(argv, '--limit')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err

    args = base.dup
    args['branch'] = branch if branch
    args['limit'] = limit.to_i if limit
    tool_call(slug, 'history', args)

  when 'revoke-preview'
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    target = argv.shift || base['preview_url'] || base['token']
    return failure('revoke-preview requires SLUG URL_OR_TOKEN', code: 'USAGE') unless target

    args = base.merge(target.include?('://') ? { 'preview_url' => target } : { 'token' => target })
    tool_call(slug, 'revoke_preview', args)

  when 'wait-preview'
    branch = opt(argv, '--branch') || base['branch'] || DEFAULT_BRANCH
    timeout = (opt(argv, '--timeout') || 120).to_i
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    cmd_wait_preview(slug, branch, timeout)
  end
end

def run(argv)
  command = argv.shift
  case command
  when '-h', '--help', 'help', nil then return usage
  when '-v', '--version' then return success(version: VERSION)

  # -- runner-based site folder commands --
  when 'list'
    slug = argv.find { |a| a != '--prod' }
    prod = argv.include?('--prod')
    return slug ? cmd_list_files(slug, opt(argv, '--prefix')) : cmd_list(prod: prod)
  when 'show'
    slug = argv.find { |a| a != '--prod' }
    return failure("show requires SLUG", code: 'USAGE') unless slug
    return cmd_show(slug, prod: argv.include?('--prod'))
  when 'open'
    slug = argv.find { |a| a != '--prod' }
    return failure("open requires SLUG", code: 'USAGE') unless slug
    return cmd_open(slug, prod: argv.include?('--prod'))
  when 'create'
    prod = argv.include?('--prod')
    name = opt(argv, '--name')
    team = opt(argv, '--team')
    slug = argv.find { |a| a != '--prod' }
    return failure("create requires SLUG", code: 'USAGE') unless slug
    return cmd_create(slug, name, team, prod: prod)

  # -- describe_site is one tool on both contracts: the server answers in the
  #    legacy shape for a legacy site and the v2 shape for a versioned one, so
  #    one subcommand takes both the legacy PATH and the v2 --branch. --
  when 'describe_site', 'describe'
    slug = argv.shift
    return failure("#{command} requires SLUG", code: 'USAGE') unless slug
    base, err = json_arguments(argv)
    return fail_with(err) if err
    branch = opt(argv, '--branch')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    path = argv.shift
    args = base.dup
    args['path'] = path if path
    args['branch'] = branch if branch
    return cmd_describe_site(slug, args)

  # -- legacy file tools (HTTP) --
  when 'list_files'
    slug = argv.shift
    return failure("list_files requires SLUG", code: 'USAGE') unless slug
    return cmd_list_files(slug, opt(argv, '--prefix'))
  when 'read_file'
    slug = argv.shift
    path = argv.shift
    return failure("read_file requires SLUG PATH", code: 'USAGE') unless slug && path
    return cmd_read_file(slug, path, view: opt(argv, '--view') || 'current')
  when 'write_file', 'write'
    slug = argv.shift
    path = argv.shift
    return failure("#{command} requires SLUG PATH", code: 'USAGE') unless slug && path
    file_path = opt(argv, '--file')
    expected_version = opt(argv, '--expected-version')
    return cmd_write_file_upload(slug, path, file_path, expected_version) if file_path
    content = opt(argv, '--content')
    return failure("#{command} requires --content or --file", code: 'USAGE') unless content
    return cmd_write_file(slug, path, content, expected_version)
  when 'edit_file', 'edit'
    slug = argv.shift
    path = argv.shift
    return failure("#{command} requires SLUG PATH", code: 'USAGE') unless slug && path
    edits_file = opt(argv, '--edits-file')
    return failure("#{command} requires --edits-file", code: 'USAGE') unless edits_file
    edits, err = json_file(edits_file, '--edits-file')
    return fail_with(err) if err
    return cmd_edit_file(slug, path, edits, opt(argv, '--expected-version'))

  # -- publish is one tool on both contracts too: a PATH is the legacy form,
  #    --review / --keys is the versioned one (plan 30 section 5.2). --
  when 'publish'
    slug = argv.shift
    return failure("publish requires SLUG", code: 'USAGE') unless slug
    base, err = json_arguments(argv)
    return fail_with(err) if err
    review = opt(argv, '--review') || base['review']
    keys = split_list(opt_all(argv, '--keys'))
    keys = Array(base['keys']) if keys.empty? && base['keys']
    branch = opt(argv, '--branch') || base['branch']
    expected_flag = opt(argv, '--expected') || base['expected']
    idempotency = opt(argv, '--idempotency-key') || base['idempotency_key']
    expected_version = opt(argv, '--expected-version')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    path = argv.shift

    if review
      return cmd_publish_review(slug, review, branch || DEFAULT_BRANCH, base, idempotency)
    end
    if keys.any? || expected_flag
      expected, err = resolve_expected(slug, branch || DEFAULT_BRANCH, expected_flag)
      return fail_with(err) if err
      args = base.merge('expected' => expected, 'idempotency_key' => idempotency || SecureRandom.uuid)
      args['keys'] = keys if keys.any?
      args['branch'] = branch if branch
      return cmd_publish_keys(slug, branch || DEFAULT_BRANCH, args)
    end
    return failure("publish requires PATH (legacy), --review TOKEN, or --expected TOKEN --keys ...", code: 'USAGE') unless path
    return cmd_publish_legacy(slug, path, expected_version)

  # -- versioned tools --
  when 'read', 'save', 'create-branch', 'archive-branch', 'diff', 'merge-live',
       'resolve-merge', 'history', 'revoke-preview', 'wait-preview'
    return run_v2(command, argv)

  # -- platform tools: a personal bearer at /api/v1/platform/tools. Naming a
  #    SLUG asks through that site's door instead: with the site's own token
  #    that answers with just that site, and with a personal token it answers
  #    the same list the platform door would. --
  when 'list-sites'
    base, err = json_arguments(argv)
    return fail_with(err) if err
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    slug = argv.shift
    if slug
      credential = credential_for(slug)
      return fail_with(no_credential_error(slug)) unless credential
      return tool_call(slug, 'list_sites', base, credential: credential)
    end
    return platform_tool_call('_platform', 'list_sites', base, 'list-sites',
                              "Or name one site you already hold a token for: `sites-cli list-sites SLUG`")

  when 'platform-tools'
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    return cmd_platform_tools

  when 'create-site'
    base, err = json_arguments(argv)
    return fail_with(err) if err
    name = opt(argv, '--name') || base['name']
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    slug = argv.shift || base['slug']
    return failure("create-site requires SLUG --name NAME", code: 'USAGE') unless slug && name
    return platform_tool_call(slug, 'create_site', base.merge('slug' => slug, 'name' => name), 'create-site',
                              "Creating a site is GXB staff only. The runner command " \
                              "`sites-cli create #{slug} --name #{name.inspect}` needs no token at all.")

  # -- the two site tools with no subcommand until now. list_submissions asks
  #    for read_submissions, which is its own capability: a plain `read` token
  #    is refused, and a scope cannot be added to a token after it is minted. --
  when 'list-submissions'
    slug = argv.shift
    return failure("list-submissions requires SLUG", code: 'USAGE') unless slug
    base, err = json_arguments(argv)
    return fail_with(err) if err
    form = opt(argv, '--form') || base['form_slug']
    since = opt(argv, '--since') || base['since']
    limit = opt(argv, '--limit') || base['limit']
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    return cmd_list_submissions(slug, base, form: form, since: since, limit: limit)

  when 'analytics'
    slug = argv.shift
    return failure("analytics requires SLUG", code: 'USAGE') unless slug
    base, err = json_arguments(argv)
    return fail_with(err) if err
    period = opt(argv, '--period') || base['period']
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    unless period.nil? || ANALYTICS_PERIODS.include?(period)
      return failure("--period takes one of #{ANALYTICS_PERIODS.join(', ')}", code: 'USAGE')
    end
    args = base.dup
    args['period'] = period if period
    return tool_call(slug, 'get_analytics', args)

  when 'fragment'
    prefix = opt(argv, '--prefix') || 'assets/'
    page_key = opt(argv, '--page')
    title = opt(argv, '--title')
    append_to = opt(argv, '--append-changes')
    wrap_body = flag?(argv, '--wrap-body')
    add_form_result = flag?(argv, '--add-form-result')
    lift_json_ld = flag?(argv, '--lift-json-ld')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    file = argv.shift
    return failure("fragment requires FILE (or - for stdin)", code: 'USAGE') unless file
    return cmd_fragment(file, prefix: prefix, page_key: page_key, title: title, append_to: append_to,
                        wrap_body: wrap_body, add_form_result: add_form_result, lift_json_ld: lift_json_ld)

  when 'upload'
    slug = argv.shift
    return failure("upload requires SLUG FILE [FILE...]", code: 'USAGE') unless slug
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    return cmd_upload(slug, argv)

  when 'push'
    slug = argv.shift
    branch = opt(argv, '--branch') || DEFAULT_BRANCH
    prefix = opt(argv, '--prefix') || 'assets/'
    expected = opt(argv, '--expected')
    offline = flag?(argv, '--offline')
    dry_run = flag?(argv, '--dry-run') || offline
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    dir = argv.shift
    return failure("push requires SLUG DIR", code: 'USAGE') unless slug && dir
    return cmd_push(slug, dir, branch: branch, prefix: prefix, expected: expected, dry_run: dry_run, offline: offline)

  when 'check'
    width = (opt(argv, '--width') || 1440).to_i
    height = (opt(argv, '--height') || 900).to_i
    screenshot = opt(argv, '--screenshot')
    against = opt(argv, '--against')
    ignore = split_list(opt_all(argv, '--ignore'))
    probe = !flag?(argv, '--no-probe')
    full = !flag?(argv, '--viewport')
    flag_err = unknown_flags(argv, command)
    return fail_with(flag_err) if flag_err
    url = argv.shift
    return failure("check requires URL", code: 'USAGE') unless url
    return cmd_check(url, width: width, height: height, screenshot: screenshot, ignore: ignore,
                     probe: probe, against: against, full: full)

  else
    return failure("Unknown command: #{command}", code: 'USAGE')
  end
end

# Nothing this binary does is worth a raw Ruby backtrace on somebody's
# terminal: an agent reading stdout gets the same envelope it gets for every
# other failure, and the shape that surprised us rides in the message.
begin
  exit run(ARGV.dup)
rescue Interrupt
  exit 130
rescue Errno::EPIPE
  exit 0
rescue StandardError => e
  exit failure("sites-cli could not finish: #{e.class}: #{e.message}", code: 'INTERNAL')
end
