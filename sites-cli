#!/usr/bin/env ruby
# frozen_string_literal: true

# sites-cli — GXB tenant site management
# Local:  SITES_ROOT/bin/rails runner FILE.rb (list/show/open/create)
# Prod:   SITES_ROOT + kamal-cli runner FILE.rb
# Text file tools (describe_site/list_files/read_file/write_file/edit_file/
# publish) talk HTTP to the site-token gateway instead -- see the "Text file
# tools" section below.
# Config: SITES_ROOT env; default ~/projects/sites

require 'json'
require 'optparse'
require 'tempfile'
require 'open3'
require 'fileutils'
require 'stringio'
require 'net/http'
require 'uri'

VERSION = '1.0.0'
SITES_ROOT = File.expand_path(ENV.fetch('SITES_ROOT', File.expand_path('~/projects/sites')))

# -----------------------------------------------------------------------------
# Output helpers
# -----------------------------------------------------------------------------

def emit(data)
  puts JSON.generate(data)
  $stdout.flush
end

def success(data)
  emit(ok: true, data: data)
  0
end

# status/body pass through the API's real HTTP status and full structured
# 409/422 payload (e.g. conflict path/version) instead of collapsing them
# into one message string.
def failure(msg, code: 'ERROR', status: nil, body: nil)
  payload = { ok: false, error: msg, code: code }
  payload[:status] = status if status
  payload[:body] = body if body
  emit(payload)
  1
end

# -----------------------------------------------------------------------------
# Run the runner locally or through kamal-cli
# -----------------------------------------------------------------------------

def sites_env
  env = ENV.to_h
  version_file = File.join(SITES_ROOT, '.ruby-version')
  env['RBENV_VERSION'] = File.read(version_file).strip if File.file?(version_file)
  shims = File.expand_path('~/.rbenv/shims')
  env['PATH'] = "#{shims}:#{env['PATH']}" if File.directory?(shims)
  env
end

def run_runner(script, prod:)
  file = Tempfile.new(['sites-cli-', '.rb'])
  file.write(script)
  file.close

  if prod
    Dir.chdir(SITES_ROOT) do
      out, err, status = Open3.capture3(sites_env, 'kamal-cli', 'runner', file.path)
      return parse_kamal_output(out, err, status)
    end
  else
    Dir.chdir(SITES_ROOT) do
      out, err, status = Open3.capture3(sites_env, 'bin/rails', 'runner', file.path)
      if status.success?
        begin
          data = JSON.parse(out.lines.find { |l| l.start_with?('{') } || out)
          return success(data)
        rescue JSON::ParserError
          return success(stdout: out.strip, stderr: err.strip)
        end
      else
        return failure("rails runner failed\n#{err.strip}\n#{out.strip}", code: 'RUNNER_FAILED')
      end
    end
  end
ensure
  file&.unlink
end

def parse_kamal_output(out, err, status)
  begin
    parsed = JSON.parse(out)
  rescue JSON::ParserError
    return failure("kamal-cli did not return JSON\nOUT: #{out.strip}\nERR: #{err.strip}", code: 'KAMAL_JSON_ERROR')
  end

  unless parsed['ok']
    return failure("kamal-cli failed: #{parsed['error'] || parsed.inspect}", code: 'KAMAL_FAILED')
  end

  runner_stdout = parsed.dig('data', 'stdout').to_s
  runner_stderr = parsed.dig('data', 'stderr').to_s
  runner_status = parsed.dig('data', 'exit')

  if runner_status.to_i.zero?
    begin
      data = JSON.parse(runner_stdout.lines.find { |l| l.start_with?('{') } || runner_stdout)
      return success(data)
    rescue JSON::ParserError
      return success(stdout: runner_stdout.strip, stderr: runner_stderr.strip)
    end
  else
    return failure("runner exited #{runner_status}\n#{runner_stderr.strip}\n#{runner_stdout.strip}", code: 'RUNNER_EXIT_FAILED')
  end
end

# -----------------------------------------------------------------------------
# Stdout capture helper (used by open to extract URL without double-printing)
# -----------------------------------------------------------------------------

def capture_stdout
  old = $stdout
  $stdout = StringIO.new
  yield
  $stdout.string
ensure
  $stdout = old
end

# -----------------------------------------------------------------------------
# Runner-based commands: list / show / open / create
# -----------------------------------------------------------------------------

def cmd_list(prod:)
  script = <<~RUBY
    sites = Site.includes(:domains).order(:slug)
    puts JSON.generate(sites.map { |s| {
      slug: s.slug,
      name: s.name,
      status: s.status,
      host: s.canonical_host,
      url: "https://\#{s.canonical_host}",
      pages: s.pages.live.count
    }})
  RUBY
  run_runner(script, prod: prod)
end

def cmd_show(slug, prod:)
  script = <<~RUBY
    site = Site.find_by!(slug: #{JSON.dump(slug)})
    puts JSON.generate({
      slug: site.slug,
      name: site.name,
      status: site.status,
      host: site.canonical_host,
      url: "https://\#{site.canonical_host}",
      pages: site.pages.live.map { |p| { path: p.path, title: p.live_revision&.title } },
      domains: site.domains.pluck(:host),
      tailwind: site.settings["tailwind"],
      noindex: site.home&.noindex
    })
  RUBY
  run_runner(script, prod: prod)
end

def cmd_open(slug, prod:)
  script = <<~RUBY
    site = Site.find_by!(slug: #{JSON.dump(slug)})
    puts JSON.generate({ slug: site.slug, host: site.canonical_host, url: "https://\#{site.canonical_host}" })
  RUBY

  captured = capture_stdout { run_runner(script, prod: prod) }
  json_line = captured.lines.find { |l| l.start_with?('{') }
  output = json_line ? (JSON.parse(json_line) rescue {}) : {}
  return failure("could not resolve site URL", code: 'URL_ERROR') unless output['ok']

  url = output.dig('data', 'url')
  return failure("runner did not return a URL", code: 'URL_ERROR') unless url

  if prod
    system('open', url)
    return success(url: url, opened: true)
  else
    puts "\nPreview URL (production): #{url}"
    puts "Local inspection (Host header): curl -H 'Host: #{slug}.gxbsites.com' http://sites.localhost/"
    return success(url: url, opened: false, local_curl: "curl -H 'Host: #{slug}.gxbsites.com' http://sites.localhost/")
  end
end

# Staff-only create (plans/24-agent-sites.md slice 3 item 19): mints no agent
# create_site tool. A token and a form recipient are separate steps after
# this, not automatic -- see the admin site page once this returns.
def cmd_create(slug, name, team, prod:)
  script = <<~RUBY
    team = Team.find_or_create_by!(name: #{JSON.dump(team || 'GXB')})
    site = Site.create!(slug: #{JSON.dump(slug)}, name: #{JSON.dump(name || slug)}, team: team)
    puts JSON.generate({ slug: site.slug, name: site.name, host: site.canonical_host, url: "https://\#{site.canonical_host}" })
  RUBY
  run_runner(script, prod: prod)
end

# -----------------------------------------------------------------------------
# Text file tools: describe_site, list_files, read_file, write_file,
# edit_file, publish (plans/24-agent-sites.md slice 3 item 18). These talk
# HTTP to the site-token gateway (Api::V1::ToolsController) -- a site token
# is scoped to exactly one site, unlike the runner credentials the commands
# above use. write --file streams a binary upload through the media API
# (plans/24-agent-sites.md slice 5a: single PUT, jpg/png/webp/gif).
# -----------------------------------------------------------------------------

CONFIG_DIR = File.expand_path(ENV.fetch('SITES_CLI_CONFIG_DIR', '~/.config/sites-cli'))
TOKENS_PATH = File.join(CONFIG_DIR, 'tokens.json')
STATE_PATH = File.join(CONFIG_DIR, 'state.json')
API_HOST = ENV.fetch('SITES_CLI_HOST', 'https://sites.gxb.vc')

def load_json(path)
  File.file?(path) ? (JSON.parse(File.read(path)) rescue {}) : {}
end

def save_json(path, data)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(data))
  File.chmod(0o600, path)
end

# Credentials live outside this git checkout (~/.config, not ~/tools/sites-cli)
# and get tightened to owner-only on every read, in case the file was
# created or edited by hand with looser permissions.
def secure_permissions!(path)
  return unless File.file?(path)
  File.chmod(0o600, path) unless (File.stat(path).mode & 0o777) == 0o600
end

def token_for(slug)
  secure_permissions!(TOKENS_PATH)
  load_json(TOKENS_PATH)[slug]
end

# read_file caches {slug, path, version} locally so write/edit/publish can
# default --expected-version from the caller's own last read -- a write
# never preceded by a read still fails, and a 409 is never silently retried.
def state_key(slug, path) = "#{slug}/#{path}"

def remember_version(slug, path, version)
  return unless version
  state = load_json(STATE_PATH)
  state[state_key(slug, path)] = version
  save_json(STATE_PATH, state)
end

def cached_version(slug, path) = load_json(STATE_PATH)[state_key(slug, path)]

def api_call(slug, tool, arguments)
  token = token_for(slug)
  return nil, failure("no token configured for #{slug} -- add it to #{TOKENS_PATH}", code: 'NO_TOKEN') unless token

  uri = URI.join(API_HOST, '/api/v1/tools')
  req = Net::HTTP::Post.new(uri)
  req['Authorization'] = "Bearer #{token}"
  req['Content-Type'] = 'application/json'
  req.body = JSON.generate(tool: tool, arguments: arguments)

  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') { |http| http.request(req) }
  body = begin
    JSON.parse(res.body.to_s)
  rescue JSON::ParserError
    { 'error' => res.body }
  end

  return [ body, nil ] if res.code.to_i.between?(200, 299)

  [ nil, failure(body['message'] || body['error'] || "HTTP #{res.code}", code: (body['error'] || "HTTP_#{res.code}").to_s, status: res.code.to_i, body: body) ]
end

def cmd_describe_site(slug, path)
  data, err = api_call(slug, 'describe_site', path ? { path: path } : {})
  return err if err
  success(data)
end

def cmd_list_files(slug, prefix)
  data, err = api_call(slug, 'list_files', prefix ? { prefix: prefix } : {})
  return err if err
  success(data)
end

def cmd_read_file(slug, path, view:)
  data, err = api_call(slug, 'read_file', { path: path, view: view })
  return err if err
  remember_version(slug, path, data['version'])
  success(data)
end

def cmd_write_file(slug, path, content, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'write_file', { path: path, content: content, expected_version: version })
  return err if err
  remember_version(slug, path, data['version'])
  success(data)
end

def cmd_edit_file(slug, path, edits, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'edit_file', { path: path, edits: edits, expected_version: version })
  return err if err
  remember_version(slug, path, data['version'])
  success(data)
end

def cmd_publish(slug, path, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version -- read_file/describe_site #{path} first", code: 'NO_VERSION') unless version

  data, err = api_call(slug, 'publish', { path: path, expected_version: version })
  return err if err
  success(data)
end

# -----------------------------------------------------------------------------
# Media upload: authorize -> stage bytes -> complete -> poll until
# ready/failed. A photo (5a) is one presigned PUT streamed from disk. A
# video (5b) is multipart: bounded batches of part presigns, each part
# retried independently, a bounded number of parts in flight at once, and
# an abort call if it can't be finished -- never the whole file buffered at
# once either way.
# -----------------------------------------------------------------------------

MEDIA_CONTENT_TYPES = {
  '.jpg' => 'image/jpeg', '.jpeg' => 'image/jpeg', '.png' => 'image/png',
  '.webp' => 'image/webp', '.gif' => 'image/gif', '.mp4' => 'video/mp4'
}.freeze

PART_CONCURRENCY = 4
PART_MAX_ATTEMPTS = 3

def media_api_call(slug, method, path, body)
  token = token_for(slug)
  return nil, failure("no token configured for #{slug} -- add it to #{TOKENS_PATH}", code: 'NO_TOKEN') unless token

  uri = URI.join(API_HOST, path)
  req_class = { get: Net::HTTP::Get, delete: Net::HTTP::Delete }.fetch(method, Net::HTTP::Post)
  req = req_class.new(uri)
  req['Authorization'] = "Bearer #{token}"
  if body
    req['Content-Type'] = 'application/json'
    req.body = JSON.generate(body)
  end

  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') { |http| http.request(req) }
  parsed = begin
    JSON.parse(res.body.to_s)
  rescue JSON::ParserError
    { 'error' => res.body }
  end
  return [ parsed, nil ] if res.code.to_i.between?(200, 299)

  [ nil, failure(parsed['message'] || parsed['error'] || "HTTP #{res.code}", code: (parsed['error'] || "HTTP_#{res.code}").to_s, status: res.code.to_i, body: parsed) ]
end

# A streamed PUT (body_stream, not the whole file in memory) against the
# presigned URL the authorize step returned. content_length must match the
# byte_size sent at authorize -- R2 rejects the signature otherwise.
def put_upload(upload_url, file_path, content_type, byte_size)
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req['Content-Type'] = content_type
  req.content_length = byte_size
  req.body_stream = File.open(file_path, 'rb')
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') { |http| http.request(req) }
  req.body_stream.close
  res.code.to_i.between?(200, 299) ? nil : failure("upload PUT failed: HTTP #{res.code}", code: 'UPLOAD_FAILED', status: res.code.to_i)
end

def cmd_write_file_upload(slug, path, file_path, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version
  return failure("no such file: #{file_path}", code: 'NO_FILE') unless File.file?(file_path)

  content_type = MEDIA_CONTENT_TYPES[File.extname(file_path).downcase]
  return failure("unsupported file extension #{File.extname(file_path)} -- accepts jpg/jpeg/png/webp/gif/mp4", code: 'BAD_TYPE') unless content_type

  data, err = media_api_call(slug, :post, '/api/v1/media/uploads',
    { label: path, content_type: content_type, byte_size: File.size(file_path), expected_version: version })
  return err if err
  upload_id = data['id']

  if data['multipart']
    parts, part_err = upload_video_parts(slug, upload_id, file_path, data['parts_count'], data['part_size'])
    if part_err
      media_api_call(slug, :delete, "/api/v1/media/uploads/#{upload_id}", nil)
      return part_err
    end
    complete_body = { parts: parts }
  else
    put_err = put_upload(data['upload_url'], file_path, content_type, File.size(file_path))
    return put_err if put_err
    complete_body = {}
  end

  data, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/complete", complete_body)
  return err if err

  status = data['status']
  until %w[ready failed].include?(status)
    sleep 1
    data, err = media_api_call(slug, :get, "/api/v1/media/uploads/#{upload_id}", nil)
    return err if err
    status = data['status']
  end

  return failure(data['error'] || 'upload verification failed', code: 'UPLOAD_FAILED') unless status == 'ready'

  remember_version(slug, path, data['id'].to_s)
  success(data)
end

# Bounded-parallelism multipart upload (plans/24-agent-sites.md 5b): a fixed
# worker count pulls part numbers off a shared queue, each part fetched and
# retried independently (part_max_attempts each, a fresh presign every
# attempt so an expired one just renews), at most one part's bytes
# (part_size, 16 MiB) resident per worker regardless of total file size.
def upload_video_parts(slug, upload_id, file_path, parts_count, part_size)
  total_size = File.size(file_path)
  queue = Queue.new
  (1..parts_count).each { |n| queue << n }
  results = Array.new(parts_count)
  mutex = Mutex.new
  first_error = nil

  workers = [ PART_CONCURRENCY, parts_count ].min.times.map do
    Thread.new do
      loop do
        part_number = begin queue.pop(true) rescue nil end
        break unless part_number
        mutex.synchronize { break if first_error }

        etag, err = upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size)
        mutex.synchronize do
          if err
            first_error ||= err
          else
            results[part_number - 1] = { part_number: part_number, etag: etag }
          end
        end
      end
    end
  end
  workers.each(&:join)

  return [ nil, first_error ] if first_error
  [ results, nil ]
end

def upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size)
  offset = (part_number - 1) * part_size
  length = [ part_size, total_size - offset ].min

  attempts = 0
  loop do
    attempts += 1
    presign, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/parts", { part_numbers: [ part_number ] })
    return [ nil, err ] if err

    part_url = presign.dig('parts', 0, 'upload_url')
    return [ nil, failure("no presigned URL returned for part #{part_number}", code: 'PART_UPLOAD_FAILED') ] unless part_url

    etag = put_part(part_url, file_path, offset, length)
    return [ etag, nil ] if etag
    return [ nil, failure("part #{part_number} failed after #{attempts} attempts", code: 'PART_UPLOAD_FAILED') ] if attempts >= PART_MAX_ATTEMPTS
  end
end

# Bounded to exactly this part's bytes (<=16 MiB), never the whole file.
def put_part(upload_url, file_path, offset, length)
  bytes = File.open(file_path, 'rb') { |f| f.seek(offset); f.read(length) }
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req.content_length = length
  req.body = bytes
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') { |http| http.request(req) }
  res.code.to_i.between?(200, 299) ? res['etag'] : nil
end

# -----------------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------------

def usage
  puts <<~USAGE
    sites-cli — GXB tenant site management

    Site folder commands (runner-based, staff-only):
      sites-cli list [--prod]              List tenant sites
      sites-cli show SLUG [--prod]         Show a tenant site
      sites-cli open SLUG [--prod]         Print URL; with --prod, open it
      sites-cli create SLUG [--name NAME] [--team TEAM] [--prod]
                                            Staff-only: create an empty site

    Text file tools (HTTP, via a site token in #{TOKENS_PATH}):
      sites-cli describe_site SLUG [PATH]           alias: describe
      sites-cli list_files SLUG [--prefix P]        alias: list SLUG
      sites-cli read_file SLUG PATH [--view live]   alias: read
      sites-cli write_file SLUG PATH --content C --expected-version V
                                                     alias: write
      sites-cli write_file SLUG assets/hero.jpg --file ./hero.jpg [--expected-version V]
                                                     binary upload: authorize -> complete -> poll.
                                                     jpg/png/webp/gif is one presigned PUT streamed
                                                     from disk. mp4 is multipart: bounded batches of
                                                     part presigns, each part retried independently,
                                                     a bounded number of parts in flight, aborted on
                                                     unrecoverable failure.
      sites-cli edit_file SLUG PATH --edits-file F.json --expected-version V
                                                     alias: edit
      sites-cli publish SLUG PATH --expected-version V

    read_file caches {slug, path, version} in #{STATE_PATH}, so
    write/edit/publish can omit --expected-version right after a read. A
    write never preceded by a read still fails, and a 409 is never silently
    retried -- rerun read_file/describe_site and look at it before retrying.

    Environment:
      SITES_ROOT            Path to sites Rails app (default: ~/projects/sites)
      SITES_CLI_HOST         Site-token gateway host (default: https://sites.gxb.vc)
      SITES_CLI_CONFIG_DIR   Token/state directory (default: ~/.config/sites-cli)

    Examples:
      sites-cli create metrolocksmith --name "Metro Locksmith"
      sites-cli describe_site acme
      sites-cli read_file acme about.md
      sites-cli write_file acme about.md --content "$(cat about.md)"
      sites-cli write_file acme assets/hero.jpg --file ./hero.jpg
      sites-cli publish acme about.md
  USAGE
  0
end

def opt(argv, flag)
  i = argv.index(flag)
  return nil unless i
  argv.delete_at(i)
  argv.delete_at(i)
end

def run(argv)
  command = argv.shift
  case command
  when '-h', '--help', 'help', nil then return usage

  # -- runner-based site folder commands --
  when 'list'
    slug = argv.find { |a| a != '--prod' }
    prod = argv.include?('--prod')
    return slug ? cmd_list_files(slug, opt(argv, '--prefix')) : cmd_list(prod: prod)
  when 'show'
    slug = argv.find { |a| a != '--prod' }
    return failure("show requires SLUG", code: 'USAGE') unless slug
    return cmd_show(slug, prod: argv.include?('--prod'))
  when 'open'
    slug = argv.find { |a| a != '--prod' }
    return failure("open requires SLUG", code: 'USAGE') unless slug
    return cmd_open(slug, prod: argv.include?('--prod'))
  when 'create'
    prod = argv.include?('--prod')
    name = opt(argv, '--name')
    team = opt(argv, '--team')
    slug = argv.find { |a| a != '--prod' }
    return failure("create requires SLUG", code: 'USAGE') unless slug
    return cmd_create(slug, name, team, prod: prod)

  # -- text file tools (HTTP) --
  when 'describe_site', 'describe'
    slug = argv.shift
    return failure("#{command} requires SLUG", code: 'USAGE') unless slug
    return cmd_describe_site(slug, argv.shift)
  when 'list_files'
    slug = argv.shift
    return failure("list_files requires SLUG", code: 'USAGE') unless slug
    return cmd_list_files(slug, opt(argv, '--prefix'))
  when 'read_file', 'read'
    slug = argv.shift
    path = argv.shift
    return failure("#{command} requires SLUG PATH", code: 'USAGE') unless slug && path
    return cmd_read_file(slug, path, view: opt(argv, '--view') || 'current')
  when 'write_file', 'write'
    slug = argv.shift
    path = argv.shift
    return failure("#{command} requires SLUG PATH", code: 'USAGE') unless slug && path
    file_path = opt(argv, '--file')
    expected_version = opt(argv, '--expected-version')
    return cmd_write_file_upload(slug, path, file_path, expected_version) if file_path
    content = opt(argv, '--content')
    return failure("#{command} requires --content or --file", code: 'USAGE') unless content
    return cmd_write_file(slug, path, content, expected_version)
  when 'edit_file', 'edit'
    slug = argv.shift
    path = argv.shift
    return failure("#{command} requires SLUG PATH", code: 'USAGE') unless slug && path
    edits_file = opt(argv, '--edits-file')
    return failure("#{command} requires --edits-file", code: 'USAGE') unless edits_file
    edits = JSON.parse(File.read(edits_file))
    return cmd_edit_file(slug, path, edits, opt(argv, '--expected-version'))
  when 'publish'
    slug = argv.shift
    path = argv.shift
    return failure("publish requires SLUG PATH", code: 'USAGE') unless slug && path
    return cmd_publish(slug, path, opt(argv, '--expected-version'))
  else
    return failure("Unknown command: #{command}", code: 'USAGE')
  end
end

exit run(ARGV.dup)
