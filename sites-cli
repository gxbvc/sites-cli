# -----------------------------------------------------------------------------
# Media upload: authorize -> stage bytes -> complete -> poll until
# ready/failed. A photo (plans/24 5a) is one presigned PUT streamed from disk.
# A video (5b) is multipart: bounded batches of part presigns, each part
# retried independently, a bounded number of parts in flight at once, and an
# abort call if it can't be finished -- never the whole file buffered at once
# either way. A versioned site (plan 30 section 1.1 step 2) omits `label` and
# sends `filename`; the digest in the response is what `save` binds.
# -----------------------------------------------------------------------------

# What the legacy file API takes. Unchanged on purpose: a legacy site's
# assets/ label is the name its published HTML already references.
MEDIA_CONTENT_TYPES = {
  '.jpg' => 'image/jpeg', '.jpeg' => 'image/jpeg', '.png' => 'image/png',
  '.webp' => 'image/webp', '.gif' => 'image/gif', '.mp4' => 'video/mp4'
}.freeze

# The plan 30 / slice B set. .mjs is accepted as a filename but the server
# delivers it as asset.js with text/javascript -- the suffix comes from the
# validated type, never from the filename (slice B deviation 3).
UPLOAD_CONTENT_TYPES = MEDIA_CONTENT_TYPES.merge(
  '.js' => 'text/javascript', '.mjs' => 'text/javascript',
  '.css' => 'text/css', '.svg' => 'image/svg+xml',
  '.glb' => 'model/gltf-binary',
  '.woff' => 'font/woff', '.woff2' => 'font/woff2',
  '.json' => 'application/json', '.txt' => 'text/plain'
).freeze

PART_CONCURRENCY = 4
PART_MAX_ATTEMPTS = 3
UPLOAD_CONCURRENCY = 4
UPLOAD_POLL_TIMEOUT = 300
UPLOAD_POLL_INTERVAL = 1

def media_api_call(slug, method, path, body, token: nil)
  token ||= token_for(slug)
  return [nil, api_error("no token configured for #{slug} -- add it to #{TOKENS_PATH}", code: 'NO_TOKEN')] unless token

  uri = URI.join(API_HOST, path)
  req_class = { get: Net::HTTP::Get, delete: Net::HTTP::Delete }.fetch(method, Net::HTTP::Post)
  req = req_class.new(uri)
  req['Authorization'] = "Bearer #{token}"
  if body
    req['Content-Type'] = 'application/json'
    req.body = JSON.generate(body)
  end

  parse_api_response(http_request(req, uri))
rescue *NETWORK_ERRORS => e
  [nil, api_error("upload request failed: #{e.class}: #{e.message}", code: 'HTTP_ERROR')]
end

# A streamed PUT (body_stream, not the whole file in memory) against the
# presigned URL the authorize step returned. content_length must match the
# byte_size sent at authorize -- R2 rejects the signature otherwise.
def put_upload(upload_url, file_path, content_type, byte_size)
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req['Content-Type'] = content_type
  req.content_length = byte_size
  req.body_stream = File.open(file_path, 'rb')
  res = http_request(req, uri)
  req.body_stream.close
  res.code.to_i.between?(200, 299) ? nil : api_error("upload PUT failed: HTTP #{res.code}", code: 'UPLOAD_FAILED', status: res.code.to_i)
rescue *NETWORK_ERRORS => e
  api_error("upload PUT failed: #{e.class}: #{e.message}", code: 'UPLOAD_FAILED')
end

# The whole authorize -> stage -> complete -> poll flow for one file. `target`
# carries either a legacy {label:, expected_version:} or a versioned
# {filename:, digest:}. Returns the final upload_status body.
def media_upload(slug, file_path, content_type, target, token:)
  byte_size = File.size(file_path)
  data, err = media_api_call(slug, :post, '/api/v1/media/uploads',
                             target.merge(content_type: content_type, byte_size: byte_size), token: token)
  return [nil, err] if err
  upload_id = data['id']

  if data['multipart']
    parts, part_err = upload_video_parts(slug, upload_id, file_path, data['parts_count'], data['part_size'], token: token)
    if part_err
      media_api_call(slug, :delete, "/api/v1/media/uploads/#{upload_id}", nil, token: token)
      return [nil, part_err]
    end
    complete_body = { parts: parts }
  else
    put_err = put_upload(data['upload_url'], file_path, content_type, byte_size)
    return [nil, put_err] if put_err
    complete_body = {}
  end

  data, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/complete", complete_body, token: token)
  return [nil, err] if err

  deadline = Time.now + UPLOAD_POLL_TIMEOUT
  until %w[ready failed].include?(data['status'])
    return [nil, api_error("upload #{upload_id} still #{data['status']} after #{UPLOAD_POLL_TIMEOUT}s", code: 'UPLOAD_TIMEOUT', body: data)] if Time.now >= deadline
    sleep UPLOAD_POLL_INTERVAL
    data, err = media_api_call(slug, :get, "/api/v1/media/uploads/#{upload_id}", nil, token: token)
    return [nil, err] if err
  end

  unless data['status'] == 'ready'
    return [nil, api_error(data['error'] || 'upload verification failed',
                           code: (data['error_code'] || 'UPLOAD_FAILED').to_s, body: data)]
  end

  [data, nil]
end

def cmd_write_file_upload(slug, path, file_path, expected_version)
  version = expected_version || cached_version(slug, path)
  return failure("no --expected-version and no cached version from a prior read_file -- read #{path} first", code: 'NO_VERSION') unless version
  return failure("no such file: #{file_path}", code: 'NO_FILE') unless File.file?(file_path)

  content_type = MEDIA_CONTENT_TYPES[File.extname(file_path).downcase]
  return failure("unsupported file extension #{File.extname(file_path)} -- accepts jpg/jpeg/png/webp/gif/mp4", code: 'BAD_TYPE') unless content_type

  data, err = media_upload(slug, file_path, content_type,
                           { label: path, expected_version: version }, token: token_for(slug))
  return fail_with(err) if err

  remember_version(slug, path, data['id'].to_s)
  success(data)
end

# Bounded-parallelism multipart upload (plans/24-agent-sites.md 5b): a fixed
# worker count pulls part numbers off a shared queue, each part fetched and
# retried independently (PART_MAX_ATTEMPTS each, a fresh presign every
# attempt so an expired one just renews), at most one part's bytes
# (part_size, 16 MiB) resident per worker regardless of total file size.
def upload_video_parts(slug, upload_id, file_path, parts_count, part_size, token:)
  total_size = File.size(file_path)
  queue = Queue.new
  (1..parts_count).each { |n| queue << n }
  results = Array.new(parts_count)
  mutex = Mutex.new
  first_error = nil

  workers = [ PART_CONCURRENCY, parts_count ].min.times.map do
    Thread.new do
      loop do
        part_number = begin queue.pop(true) rescue nil end
        break unless part_number
        mutex.synchronize { break if first_error }

        etag, err = upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size, token: token)
        mutex.synchronize do
          if err
            first_error ||= err
          else
            results[part_number - 1] = { part_number: part_number, etag: etag }
          end
        end
      end
    end
  end
  workers.each(&:join)

  return [ nil, first_error ] if first_error
  [ results, nil ]
end

def upload_one_part(slug, upload_id, file_path, part_number, part_size, total_size, token:)
  offset = (part_number - 1) * part_size
  length = [ part_size, total_size - offset ].min

  attempts = 0
  loop do
    attempts += 1
    presign, err = media_api_call(slug, :post, "/api/v1/media/uploads/#{upload_id}/parts",
                                  { part_numbers: [ part_number ] }, token: token)
    return [ nil, err ] if err

    part_url = presign.dig('parts', 0, 'upload_url')
    return [ nil, api_error("no presigned URL returned for part #{part_number}", code: 'PART_UPLOAD_FAILED') ] unless part_url

    etag = put_part(part_url, file_path, offset, length)
    return [ etag, nil ] if etag
    return [ nil, api_error("part #{part_number} failed after #{attempts} attempts", code: 'PART_UPLOAD_FAILED') ] if attempts >= PART_MAX_ATTEMPTS
  end
end

# Bounded to exactly this part's bytes (<=16 MiB), never the whole file.
def put_part(upload_url, file_path, offset, length)
  bytes = File.open(file_path, 'rb') { |f| f.seek(offset); f.read(length) }
  uri = URI(upload_url)
  req = Net::HTTP::Put.new(uri)
  req.content_length = length
  req.body = bytes
  res = http_request(req, uri)
  res.code.to_i.between?(200, 299) ? res['etag'] : nil
rescue *NETWORK_ERRORS
  nil
end

# -----------------------------------------------------------------------------
# v2 helpers: upload, push, wait-preview, check
# -----------------------------------------------------------------------------

def sha256_file(path) = Digest::SHA256.file(path).hexdigest

# One line of JSON per file, so a caller can map a local path to the digest it
# has to `save`. Four at a time; exit 1 if any file failed.
def cmd_upload(slug, files)
  return failure("upload requires SLUG FILE [FILE...]", code: 'USAGE') if files.empty?

  missing = files.reject { |f| File.file?(f) }
  return failure("no such file(s): #{missing.join(' ')}", code: 'NO_FILE') if missing.any?

  token = token_for(slug)
  return failure("no token configured for #{slug} -- add it to #{TOKENS_PATH}", code: 'NO_TOKEN') unless token

  results = upload_files(slug, files, token: token)
  results.each { |r| emit(r) }
  results.all? { |r| r[:status] == 'ready' } ? 0 : 1
end

def upload_files(slug, files, token:)
  results = Array.new(files.size)
  queue = Queue.new
  files.each_index { |i| queue << i }

  workers = [ UPLOAD_CONCURRENCY, files.size ].min.times.map do
    Thread.new do
      loop do
        index = begin queue.pop(true) rescue nil end
        break unless index
        results[index] = upload_one_file(slug, files[index], token: token)
      end
    end
  end
  workers.each(&:join)
  results
end

def upload_one_file(slug, file_path, token:)
  content_type = UPLOAD_CONTENT_TYPES[File.extname(file_path).downcase]
  unless content_type
    return { path: file_path, status: 'failed', code: 'BAD_TYPE',
             error: "unsupported file extension #{File.extname(file_path)} -- accepts #{UPLOAD_CONTENT_TYPES.keys.join(' ')}" }
  end

  digest = sha256_file(file_path)
  # `label` is omitted on a versioned site: bytes are bound to a logical path
  # later by `save`, not now. `digest` is the type-conflict hint slice B added.
  data, err = media_upload(slug, file_path, content_type,
                           { filename: File.basename(file_path), digest: digest }, token: token)
  if err
    return { path: file_path, status: 'failed', code: err[:code], error: err[:error],
             http_status: err[:status], body: err[:body] }.compact
  end

  { path: file_path, digest: data['digest'] || digest, url: data['url'],
    media_type: data['media_type'] || data['content_type'], byte_size: data['byte_size'] || data['bytes'],
    status: data['status'] }
end

# Dir.glob rather than `find` (which walks huge trees and hangs): '**/*' skips
# dotfiles and never descends into a dot directory, which is the same set
# `rg --files` lists for a tree with no .gitignore.
def walk_tree(dir)
  Dir.glob('**/*', base: dir)
     .reject { |rel| rel.split('/').any? { |segment| segment.start_with?('.') } }
     .select { |rel| File.file?(File.join(dir, rel)) }
     .sort
end

def push_entries(dir, prefix)
  walk_tree(dir).map do |rel|
    absolute = File.join(dir, rel)
    # A tree that already contains assets/ is not prefixed twice.
    key = rel.start_with?(prefix) ? rel : "#{prefix}#{rel}"
    { 'file' => absolute, 'key' => key, 'digest' => sha256_file(absolute),
      'media_type' => UPLOAD_CONTENT_TYPES[File.extname(rel).downcase], 'byte_size' => File.size(absolute) }
  end
end

def cmd_push(slug, dir, branch:, prefix:, expected:, dry_run:)
  return failure("no such directory: #{dir}", code: 'NO_DIR') unless File.directory?(dir)

  entries = push_entries(dir, prefix)
  return failure("no files under #{dir} (dotfiles are skipped)", code: 'EMPTY_TREE') if entries.empty?

  unsupported = entries.reject { |e| e['media_type'] }
  if unsupported.any?
    return failure("unsupported extension(s) in #{dir} -- accepts #{UPLOAD_CONTENT_TYPES.keys.join(' ')}",
                   code: 'BAD_TYPE', body: { 'files' => unsupported.map { |e| e['file'] } })
  end

  changes = entries.map { |e| { 'op' => 'put', 'kind' => 'asset', 'key' => e['key'], 'digest' => e['digest'] } }
  if dry_run
    return success('site' => slug, 'branch' => branch, 'dry_run' => true, 'prefix' => prefix,
                   'files' => entries.size, 'changes' => changes)
  end

  expected, err = resolve_expected(slug, branch, expected)
  return fail_with(err) if err

  token = token_for(slug)
  return failure("no token configured for #{slug} -- add it to #{TOKENS_PATH}", code: 'NO_TOKEN') unless token

  # Identical bytes anywhere in the tree are one upload; the API is content
  # addressed, so two logical paths can share one digest.
  by_digest = entries.group_by { |e| e['digest'] }
  results = upload_files(slug, by_digest.values.map { |group| group.first['file'] }, token: token)

  failed = results.reject { |r| r[:status] == 'ready' }
  if failed.any?
    failed.each { |r| emit(r) }
    return failure("#{failed.size} of #{results.size} upload(s) failed; nothing was saved", code: 'UPLOAD_FAILED')
  end

  mismatched = results.reject { |r| by_digest.key?(r[:digest]) }
  if mismatched.any?
    return failure("the server returned a digest that does not match the local bytes", code: 'DIGEST_MISMATCH',
                   body: { 'files' => mismatched.map { |r| r[:path] } })
  end

  tool_call(slug, 'save', { 'branch' => branch, 'expected' => expected,
                            'idempotency_key' => SecureRandom.uuid,
                            'message' => "push #{File.basename(dir)} (#{entries.size} assets)",
                            'changes' => changes }, token: token)
end

PREVIEW_POLL_INTERVAL = 2
PREVIEW_TERMINAL = %w[ready invalid failed].freeze

# Polls describe_site until the branch's preview build settles. "unavailable"
# is slice A's honest placeholder for a server with no build pipeline yet, so
# it is an error rather than something to wait out.
def cmd_wait_preview(slug, branch, timeout)
  deadline = Time.now + timeout

  loop do
    data, err = api_call(slug, 'describe_site', { 'branch' => branch })
    return fail_with(err) if err
    remember_expected(slug, data)

    entry = Array(data['branches']).find { |b| b.is_a?(Hash) && b['name'] == branch } || {}
    status = entry['preview_status'] || data['preview_status']
    payload = { 'site' => slug, 'branch' => branch, 'preview_status' => status,
                'preview_url' => entry['preview_url'] || data['preview_url'],
                'diagnostics' => entry['diagnostics'] || data['diagnostics'] || [],
                'review' => entry['review'] }

    return success(payload) if status == 'ready'
    if %w[invalid failed].include?(status)
      return failure("preview #{status} for #{slug}/#{branch}", code: status.upcase, body: payload)
    end
    if status.nil? || status == 'unavailable'
      return failure("this server reports preview_status #{status.inspect} for #{slug}/#{branch} -- previews arrive with slice D",
                     code: 'PREVIEW_UNAVAILABLE', body: payload)
    end
    if Time.now >= deadline
      return failure("preview still #{status} for #{slug}/#{branch} after #{timeout}s", code: 'PREVIEW_TIMEOUT', body: payload)
    end

    sleep PREVIEW_POLL_INTERVAL
  end
end

# -----------------------------------------------------------------------------
# check: load a URL in agent-browser and report what broke
# -----------------------------------------------------------------------------

AGENT_BROWSER = ENV.fetch('SITES_CLI_BROWSER', 'agent-browser')

def agent_browser(session, *args)
  out, err, status = Open3.capture3(AGENT_BROWSER, '--session', session, *args, '--json')
  parsed = begin
    JSON.parse(out.lines.find { |l| l.start_with?('{') } || out)
  rescue JSON::ParserError
    nil
  end

  if parsed.nil?
    return [nil, api_error("#{AGENT_BROWSER} #{args.first} produced no JSON (exit #{status.exitstatus}): #{err.strip.empty? ? out.strip : err.strip}",
                           code: 'BROWSER_ERROR')]
  end
  return [nil, api_error("#{AGENT_BROWSER} #{args.first} failed: #{parsed['error']}", code: 'BROWSER_ERROR')] unless parsed['success']

  [parsed['data'] || {}, nil]
rescue Errno::ENOENT
  [nil, api_error("#{AGENT_BROWSER} is not on PATH -- see ~/notes/web-browsing.md", code: 'NO_BROWSER')]
end

# agent-browser reports console messages (`console`) and uncaught page errors
# (`errors`) separately; both are console errors as far as a page check is
# concerned, so they are merged into one list.
def collect_console_errors(console, errors)
  messages = Array(console['messages']).select { |m| m.is_a?(Hash) && m['type'] == 'error' }.map { |m| m['text'].to_s }
  messages + Array(errors['errors']).map { |e| e.is_a?(Hash) ? e['text'].to_s : e.to_s }
end

def collect_failed_requests(requests, ignore)
  Array(requests['requests']).filter_map do |r|
    next unless r.is_a?(Hash)
    status = r['status']
    failed = status.nil? || status.to_i >= 400
    next unless failed
    next if ignore.any? { |needle| r['url'].to_s.include?(needle) }
    { 'url' => r['url'], 'status' => status, 'error' => r['errorText'] || r['failure'] }.compact
  end
end

def cmd_check(url, width:, height:, screenshot:, ignore:)
  session = "sites-cli-#{SecureRandom.hex(4)}"
  result = nil

  begin
    _blank, err = agent_browser(session, 'open')
    return fail_with(err) if err

    agent_browser(session, 'set', 'viewport', width.to_s, height.to_s)

    nav, err = agent_browser(session, 'open', url)
    return fail_with(err) if err

    # Best effort: a page that never goes idle still gets checked on whatever
    # it managed to load, rather than failing the whole command.
    agent_browser(session, 'wait', '--load', 'networkidle')

    console, = agent_browser(session, 'console')
    errors, = agent_browser(session, 'errors')
    requests, = agent_browser(session, 'network', 'requests')

    if screenshot
      FileUtils.mkdir_p(File.dirname(File.expand_path(screenshot)))
      agent_browser(session, 'screenshot', screenshot)
    end

    final_url = nav['url'] || url
    document = Array(requests&.dig('requests')).select { |r| r.is_a?(Hash) && r['url'] == final_url }.last
    result = {
      'status' => document && document['status'],
      'console_errors' => collect_console_errors(console || {}, errors || {}),
      'failed_requests' => collect_failed_requests(requests || {}, ignore),
      'title' => nav['title'],
      'url' => final_url
    }
    result['screenshot'] = File.expand_path(screenshot) if screenshot
  ensure
    # Every orphan agent-browser session is a full Chrome that lives until
    # reboot (~/notes/web-browsing.md), so this closes even on an early return.
    agent_browser(session, 'close')
  end

  return 1 unless result
  emit(result)
  ok = result['console_errors'].empty? && result['failed_requests'].empty? &&
       (result['status'].nil? || result['status'].to_i < 400)
  ok ? 0 : 1
end

# -----------------------------------------------------------------------------
# Argument parsing
# -----------------------------------------------------------------------------

def opt(argv, flag)
  i = argv.index(flag)
  return nil unless i
  argv.delete_at(i)
  argv.delete_at(i)
end

def opt_all(argv, flag)
  values = []
  while (value = opt(argv, flag))
    values << value
  end
  values
end

def flag?(argv, flag)
  i = argv.index(flag)
  return false unless i
  argv.delete_at(i)
  true
end

def unknown_flags(argv, command)
  leftover = argv.select { |a| a.start_with?('--') }
  return nil if leftover.empty?
  api_error("unknown option(s) for #{command}: #{leftover.join(' ')}", code: 'USAGE')
end

# --json FILE (or --json - for stdin) supplies the whole arguments object for
# a tool; explicit flags override individual keys on top of it.
def json_arguments(argv)
  source = opt(argv, '--json')
  return [{}, nil] unless source

  raw = if source == '-'
          $stdin.read
        elsif File.file?(source)
          File.read(source)
        end
  return [nil, api_error("no such file: #{source}", code: 'NO_FILE')] unless raw

  parsed = JSON.parse(raw)
  return [nil, api_error('--json must contain a JSON object', code: 'BAD_JSON')] unless parsed.is_a?(Hash)
  [parsed, nil]
rescue JSON::ParserError => e
  [nil, api_error("--json is not valid JSON: #{e.message}", code: 'BAD_JSON')]
end

def json_file(source, what)
  raw = if source == '-'
          $stdin.read
        elsif File.file?(source)
          File.read(source)
        end
  return [nil, api_error("no such file: #{source}", code: 'NO_FILE')] unless raw
  [JSON.parse(raw), nil]
rescue JSON::ParserError => e
  [nil, api_error("#{what} is not valid JSON: #{e.message}", code: 'BAD_JSON')]
end

def split_list(values)
  values.flat_map { |v| v.to_s.split(',') }.map(&:strip).reject(&:empty?)
end

